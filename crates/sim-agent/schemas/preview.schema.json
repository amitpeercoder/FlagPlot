{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flagplot-agent/preview",
  "title": "preview: what a changed intent or limit would do, worked on copies and stored nowhere",
  "description": "The staff's answer for the coming day as things stand and with the command queued last, the holds that keep ships of the intent's pool from it, what each run in hand would do, what is lost (nothing, in a supply plan) and what another intent would give up. It changes nothing; approve {\"preview\": number} queues exactly the command shown, until something is queued or a day is resolved.",
  "type": "object",
  "required": [
    "format",
    "version",
    "kind",
    "preview",
    "day",
    "command",
    "shown",
    "limits",
    "shown_limits",
    "intent",
    "as_things_stand",
    "with_change",
    "held",
    "runs_in_hand",
    "made_ready_lost",
    "other_plans_give_up",
    "valid",
    "note"
  ],
  "additionalProperties": false,
  "properties": {
    "inside_day": {
      "type": "string",
      "description": "Given only at 0600 or 1200, in a game that stops between pulses (decision 0156): the answer was worked on the state as it stands, as if the open day were closed now, before the rest of the day, its fight ashore and its end are resolved; a command is checked again when it is taken in at the next dusk."
    },
    "format": {
      "const": "flagplot-agent"
    },
    "version": {
      "const": 54
    },
    "kind": {
      "const": "preview"
    },
    "preview": {
      "type": "integer",
      "description": "The preview's number among the previews this side was shown, 1 up: another side's previews are not counted (decision 0172, 4)."
    },
    "day": {
      "type": "integer",
      "description": "The coming day."
    },
    "command": {
      "$ref": "command_defs.schema.json#/$defs/command_body"
    },
    "shown": {
      "type": "string",
      "description": "The command in words."
    },
    "limits": {
      "type": "array",
      "description": "The limits given with a set_intent (decision 0222, rule 4), each a set_limit command as it would be queued, after the order, in the order given: the staff's reading is of the order with all of them. An empty list where none was given.",
      "items": {
        "$ref": "command_defs.schema.json#/$defs/command_body"
      }
    },
    "shown_limits": {
      "type": "array",
      "description": "The words of each of the limits, in the same order. An empty list where none was given.",
      "items": {
        "type": "string"
      }
    },
    "intent": {
      "type": [
        "integer",
        "null"
      ],
      "description": "The intent concerned; null for a reserve at a base no intent loads from."
    },
    "as_things_stand": {
      "type": "object",
      "description": "What the staff would do for the intent on the coming day on one copy of the state: its orders, commands and decisions to give no order for the intent (as staff_orders shows them), the runs of its proposal (the same rules over the next 30 days) with the next of them, the first day the base's days of supply fall below the floor, and what binds.",
      "required": [
        "orders",
        "commands",
        "no_orders",
        "runs",
        "next_run",
        "first_day_below",
        "binds"
      ],
      "additionalProperties": false,
      "properties": {
        "orders": {
          "type": "array",
          "items": {
            "$ref": "command_defs.schema.json#/$defs/staff_order"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "reason"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "reason": {
                "$ref": "command_defs.schema.json#/$defs/reason"
              }
            }
          }
        },
        "no_orders": {
          "type": "array",
          "items": {
            "$ref": "command_defs.schema.json#/$defs/reason"
          }
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run"
          }
        },
        "next_run": {
          "oneOf": [
            {
              "$ref": "#/$defs/run"
            },
            {
              "type": "null"
            }
          ]
        },
        "first_day_below": {
          "type": [
            "integer",
            "null"
          ]
        },
        "stations": { "$ref": "defs.schema.json#/$defs/patrol_stations" },
        "tree": { "description": "Decision 0221, the staff's reading: for the intent with the change, the tree the staff would form, as propose gives it (null for a kind that forms none). Given only in with_change, where the staff has a proposal for the intent.", "$ref": "propose.schema.json#/properties/tree" },
        "would_hand_in": { "description": "Decision 0221: what the staff would hand in for the intent with the change, as propose gives it.", "$ref": "command_defs.schema.json#/$defs/decisions" },
        "reason": { "description": "Decision 0221: the proposal's own reason, as propose gives it.", "$ref": "command_defs.schema.json#/$defs/reason" },
        "binds": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "binds",
                "shortfall_days",
                "source_dry_day",
                "check_day",
                "displaced_by"
              ],
              "additionalProperties": false,
              "properties": {
                "binds": {
                  "type": "string"
                },
                "shortfall_days": {
                  "$ref": "defs.schema.json#/$defs/dec"
                },
                "source_dry_day": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "check_day": {
                  "type": "integer"
                },
                "displaced_by": {
                  "type": "array",
                  "items": {
                    "$ref": "command_defs.schema.json#/$defs/displacement"
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "with_change": {
      "type": "object",
      "description": "What the staff would do for the intent on the coming day on one copy of the state: its orders, commands and decisions to give no order for the intent (as staff_orders shows them), the runs of its proposal (the same rules over the next 30 days) with the next of them, the first day the base's days of supply fall below the floor, and what binds.",
      "required": [
        "orders",
        "commands",
        "no_orders",
        "runs",
        "next_run",
        "first_day_below",
        "binds"
      ],
      "additionalProperties": false,
      "properties": {
        "orders": {
          "type": "array",
          "items": {
            "$ref": "command_defs.schema.json#/$defs/staff_order"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "reason"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "reason": {
                "$ref": "command_defs.schema.json#/$defs/reason"
              }
            }
          }
        },
        "no_orders": {
          "type": "array",
          "items": {
            "$ref": "command_defs.schema.json#/$defs/reason"
          }
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run"
          }
        },
        "next_run": {
          "oneOf": [
            {
              "$ref": "#/$defs/run"
            },
            {
              "type": "null"
            }
          ]
        },
        "first_day_below": {
          "type": [
            "integer",
            "null"
          ]
        },
        "stations": { "$ref": "defs.schema.json#/$defs/patrol_stations" },
        "tree": { "description": "Decision 0221, the staff's reading: for the intent with the change, the tree the staff would form, as propose gives it (null for a kind that forms none). Given only in with_change, where the staff has a proposal for the intent.", "$ref": "propose.schema.json#/properties/tree" },
        "would_hand_in": { "description": "Decision 0221: what the staff would hand in for the intent with the change, as propose gives it.", "$ref": "command_defs.schema.json#/$defs/decisions" },
        "reason": { "description": "Decision 0221: the proposal's own reason, as propose gives it.", "$ref": "command_defs.schema.json#/$defs/reason" },
        "binds": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "binds",
                "shortfall_days",
                "source_dry_day",
                "check_day",
                "displaced_by"
              ],
              "additionalProperties": false,
              "properties": {
                "binds": {
                  "type": "string"
                },
                "shortfall_days": {
                  "$ref": "defs.schema.json#/$defs/dec"
                },
                "source_dry_day": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "check_day": {
                  "type": "integer"
                },
                "displaced_by": {
                  "type": "array",
                  "items": {
                    "$ref": "command_defs.schema.json#/$defs/displacement"
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "held": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runs_in_hand": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "made_ready_lost": {
      "type": "string"
    },
    "other_plans_give_up": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "valid": {
      "const": true
    },
    "note": {
      "type": "string"
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "required": [
        "ships",
        "load_t",
        "days"
      ],
      "additionalProperties": false,
      "properties": {
        "ships": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "load_t": {
          "$ref": "defs.schema.json#/$defs/dec"
        },
        "days": {
          "$ref": "command_defs.schema.json#/$defs/days"
        }
      }
    }
  }
}
