{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flagplot-agent/plans",
  "title": "plans: the side's plans with their runs and what each run is doing",
  "description": "Each plan's state, baseline, amendments and runs; each run with its four days, ships, load, the phase its days put it in and where its ships are.",
  "type": "object",
  "required": [
    "format",
    "version",
    "kind",
    "for_day",
    "as_at",
    "plans"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "flagplot-agent"
    },
    "version": {
      "const": 7
    },
    "kind": {
      "const": "plans"
    },
    "for_day": {
      "type": "integer"
    },
    "as_at": {
      "type": "string"
    },
    "plans": {
      "type": "array",
      "items": {
        "$ref": "command_defs.schema.json#/$defs/plan"
      }
    }
  }
}
