{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flagplot-agent/propose",
  "title": "propose: what the staff would do for one intent, worked from the view and stored nowhere",
  "description": "The projection, the runs the staff would make over the next 30 days with their days, ships, loads and reasons, what binds, what it displaces and what it would hand in for the coming day.",
  "type": "object",
  "required": [
    "format",
    "version",
    "kind",
    "for_day",
    "intent",
    "plan",
    "projection",
    "runs",
    "binds",
    "displaces",
    "displaced_by",
    "displaced_intents",
    "would_hand_in",
    "reason",
    "tree"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "flagplot-agent"
    },
    "version": {
      "const": 20
    },
    "kind": {
      "const": "propose"
    },
    "for_day": {
      "type": "integer"
    },
    "intent": {
      "type": "integer"
    },
    "plan": {
      "type": "object",
      "required": [
        "number",
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "integer"
        },
        "state": {
          "enum": [
            "draft",
            "preparing",
            "released",
            "complete",
            "failed",
            "cancelled"
          ]
        }
      }
    },
    "projection": {
      "oneOf": [
        {
          "$ref": "command_defs.schema.json#/$defs/projection"
        },
        {
          "type": "null"
        }
      ]
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "ships",
          "load_t",
          "days",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer"
          },
          "ships": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "load_t": {
            "$ref": "defs.schema.json#/$defs/dec"
          },
          "days": {
            "$ref": "command_defs.schema.json#/$defs/days"
          },
          "reason": {
            "$ref": "command_defs.schema.json#/$defs/reason"
          }
        }
      }
    },
    "binds": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "binds",
            "shortfall_days",
            "source_dry_day",
            "check_day",
            "displaced_by"
          ],
          "additionalProperties": false,
          "properties": {
            "binds": {
              "type": "string"
            },
            "shortfall_days": {
              "$ref": "defs.schema.json#/$defs/dec"
            },
            "source_dry_day": {
              "type": [
                "integer",
                "null"
              ]
            },
            "check_day": {
              "type": "integer"
            },
            "displaced_by": {
              "type": "array",
              "items": {
                "$ref": "command_defs.schema.json#/$defs/displacement"
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "displaces": {
      "type": "string",
      "description": "What the proposal is displaced by and what it displaces, in a sentence; \"nothing: one intent\" where one intent is in force."
    },
    "would_hand_in": {
      "$ref": "command_defs.schema.json#/$defs/decisions"
    },
    "reason": {
      "$ref": "command_defs.schema.json#/$defs/reason"
    },
    "displaced_by": {
      "type": "array",
      "items": {
        "$ref": "command_defs.schema.json#/$defs/displacement"
      },
      "description": "The commitments to other plans that keep this intent from a run or cut its load."
    },
    "displaced_intents": {
      "type": "array",
      "description": "The lower intents this proposal would displace, each with its shortfall at the reading it checked and the commitments of this plan that cause it.",
      "items": {
        "type": "object",
        "required": [
          "intent",
          "plan",
          "shortfall_days",
          "check_day",
          "by"
        ],
        "additionalProperties": false,
        "properties": {
          "intent": {
            "type": "integer"
          },
          "plan": {
            "type": "integer"
          },
          "shortfall_days": {
            "$ref": "defs.schema.json#/$defs/dec"
          },
          "check_day": {
            "type": "integer"
          },
          "by": {
            "type": "array",
            "items": {
              "$ref": "command_defs.schema.json#/$defs/displacement"
            }
          }
        }
      }
    },
    "tree": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "description": "For a hold or cover intent: the tree the staff would form on the coming day (decision 0117, 14): the sub-intents (each form_intent, numbered as the side's next free numbers), the air groups each intent would order with the order each is given, the search arcs with how their threats gave them, and the decisions to give no order.",
          "required": [
            "intent",
            "kind",
            "sub_intents",
            "groups",
            "arcs",
            "no_orders",
            "note"
          ],
          "additionalProperties": false,
          "properties": {
            "intent": {
              "type": "integer"
            },
            "kind": {
              "enum": [
                "cover",
                "hold",
                "neutralise",
                "raid",
                "deny",
                "strike_ships",
                "search_waters",
                "stand_at",
                "operate_carriers",
                "ready_landing",
                "build_up",
                "take_place"
              ]
            },
            "sub_intents": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "number",
                  "parent",
                  "maker",
                  "text",
                  "reason",
                  "kind",
                  "base",
                  "target",
                  "hex",
                  "distance",
                  "task_force",
                  "floor_days",
                  "interval_days",
                  "by_day",
                  "wants",
                  "defences"
                ],
                "additionalProperties": false,
                "properties": {
                  "number": {
                    "type": "integer"
                  },
                  "parent": {
                    "type": "integer"
                  },
                  "maker": {
                    "const": "staff"
                  },
                  "text": {
                    "type": "string"
                  },
                  "reason": {
                    "$ref": "command_defs.schema.json#/$defs/reason"
                  },
                  "kind": {
                    "enum": [
                      "cover",
                      "hold",
                      "neutralise",
                      "raid",
                      "deny",
                      "strike_ships",
                      "search_waters",
                      "stand_at",
                      "operate_carriers",
                      "ready_landing",
                      "build_up",
                      "take_place"
                    ]
                  },
                  "base": {
                    "oneOf": [
                      {
                        "$ref": "defs.schema.json#/$defs/handle"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "target": {
                    "oneOf": [
                      {
                        "$ref": "defs.schema.json#/$defs/handle"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "hex": {
                    "oneOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "integer"
                        }
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The centre of the waters of a deny intent as [q, r] (decision 0123), the station of a stand_at or operate_carriers intent, the landing hex of a ready_landing intent or the place of a take_place intent; null for the other kinds."
                  },
                  "distance": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "The distance in hexes of the waters of a deny intent (decision 0123); null for the other kinds."
                  },
                  "task_force": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "The side's number of the task force a stand_at, operate_carriers or ready_landing intent names (decisions 0124, 0125 and 0141); null for the other kinds (a take_place has none)."
                  },
                  "floor_days": {
                    "type": "null"
                  },
                  "interval_days": {
                    "type": "null"
                  },
                  "by_day": {
                    "type": ["integer", "null"],
                    "description": "The morning of the day a ready_landing or take_place intent is to be ready by or to have taken the place by (decisions 0141 and 0142); null for the other kinds and for one with no date."
                  },
                  "wants": {
                    "oneOf": [
                      { "type": "array", "items": { "enum": ["airfield", "mend", "defences", "port", "aircraft"] } },
                      { "type": "null" }
                    ],
                    "description": "What a build_up intent wants, in order (decision 0141); null for the other kinds."
                  },
                  "defences": {
                    "type": ["integer", "null"],
                    "description": "The points of defences a build_up intent wants, from 1 to 100, when defences is among its wants (decision 0141); null otherwise."
                  }
                }
              }
            },
            "groups": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "intent",
                  "air_groups",
                  "orders"
                ],
                "additionalProperties": false,
                "properties": {
                  "intent": {
                    "type": "integer"
                  },
                  "air_groups": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "orders": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "air_group",
                        "order",
                        "text",
                        "worked"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "air_group": {
                          "type": "integer"
                        },
                        "order": {
                          "type": "object"
                        },
                        "text": {
                          "type": "string"
                        },
                        "worked": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "arcs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "intent",
                  "air_group",
                  "from_deg",
                  "to_deg",
                  "whole_circle",
                  "range_nm",
                  "how"
                ],
                "additionalProperties": false,
                "properties": {
                  "intent": {
                    "type": "integer"
                  },
                  "air_group": {
                    "type": "integer"
                  },
                  "from_deg": {
                    "type": "integer"
                  },
                  "to_deg": {
                    "type": "integer"
                  },
                  "whole_circle": {
                    "type": "boolean"
                  },
                  "range_nm": {
                    "$ref": "defs.schema.json#/$defs/dec"
                  },
                  "how": {
                    "type": "string"
                  }
                }
              }
            },
            "no_orders": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "note": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
