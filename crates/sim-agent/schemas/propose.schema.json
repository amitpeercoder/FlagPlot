{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flagplot-agent/propose",
  "title": "propose: what the staff would do for one intent, worked from the view and stored nowhere",
  "description": "The projection, the runs the staff would make over the next 30 days with their days, ships, loads and reasons, what binds, what it displaces and what it would hand in for the coming day.",
  "type": "object",
  "required": [
    "format",
    "version",
    "kind",
    "for_day",
    "intent",
    "plan",
    "projection",
    "runs",
    "binds",
    "displaces",
    "displaced_by",
    "displaced_intents",
    "would_hand_in",
    "reason"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "flagplot-agent"
    },
    "version": {
      "const": 7
    },
    "kind": {
      "const": "propose"
    },
    "for_day": {
      "type": "integer"
    },
    "intent": {
      "type": "integer"
    },
    "plan": {
      "type": "object",
      "required": [
        "number",
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "integer"
        },
        "state": {
          "enum": [
            "draft",
            "preparing",
            "released",
            "complete",
            "failed",
            "cancelled"
          ]
        }
      }
    },
    "projection": {
      "oneOf": [
        {
          "$ref": "command_defs.schema.json#/$defs/projection"
        },
        {
          "type": "null"
        }
      ]
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "ships",
          "load_t",
          "days",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer"
          },
          "ships": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "load_t": {
            "$ref": "defs.schema.json#/$defs/dec"
          },
          "days": {
            "$ref": "command_defs.schema.json#/$defs/days"
          },
          "reason": {
            "$ref": "command_defs.schema.json#/$defs/reason"
          }
        }
      }
    },
    "binds": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "binds",
            "shortfall_days",
            "source_dry_day",
            "check_day",
            "displaced_by"
          ],
          "additionalProperties": false,
          "properties": {
            "binds": {
              "type": "string"
            },
            "shortfall_days": {
              "$ref": "defs.schema.json#/$defs/dec"
            },
            "source_dry_day": {
              "type": [
                "integer",
                "null"
              ]
            },
            "check_day": {
              "type": "integer"
            },
            "displaced_by": {
              "type": "array",
              "items": {
                "$ref": "command_defs.schema.json#/$defs/displacement"
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "displaces": {
      "type": "string",
      "description": "What the proposal is displaced by and what it displaces, in a sentence; \"nothing: one intent\" where one intent is in force."
    },
    "would_hand_in": {
      "$ref": "command_defs.schema.json#/$defs/decisions"
    },
    "reason": {
      "$ref": "command_defs.schema.json#/$defs/reason"
    },
    "displaced_by": {
      "type": "array",
      "items": {
        "$ref": "command_defs.schema.json#/$defs/displacement"
      },
      "description": "The commitments to other plans that keep this intent from a run or cut its load."
    },
    "displaced_intents": {
      "type": "array",
      "description": "The lower intents this proposal would displace, each with its shortfall at the reading it checked and the commitments of this plan that cause it.",
      "items": {
        "type": "object",
        "required": [
          "intent",
          "plan",
          "shortfall_days",
          "check_day",
          "by"
        ],
        "additionalProperties": false,
        "properties": {
          "intent": {
            "type": "integer"
          },
          "plan": {
            "type": "integer"
          },
          "shortfall_days": {
            "$ref": "defs.schema.json#/$defs/dec"
          },
          "check_day": {
            "type": "integer"
          },
          "by": {
            "type": "array",
            "items": {
              "$ref": "command_defs.schema.json#/$defs/displacement"
            }
          }
        }
      }
    }
  }
}
