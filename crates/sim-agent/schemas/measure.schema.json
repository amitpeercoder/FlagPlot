{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flagplot-agent/measure",
  "title": "measure: air distance, sea route, passage of a task force, days at the yard of a task force, air reach of an air group, the choices the rules would make now for an own unit",
  "oneOf": [
    { "$ref": "#/$defs/air_distance" },
    { "$ref": "#/$defs/sea_route" },
    { "$ref": "#/$defs/passage" },
    { "$ref": "#/$defs/yard" },
    { "$ref": "#/$defs/air_reach" },
    { "$ref": "#/$defs/choices" },
    { "$ref": "defs.schema.json#/$defs/not_known" }
  ],
  "$defs": {
    "resolved": {
      "description": "A place as asked: the hex, and the own unit or held contact it was named by, if any.",
      "type": "object",
      "required": ["unit", "place"],
      "additionalProperties": false,
      "properties": {
        "unit": { "$ref": "defs.schema.json#/$defs/handle_or_null" },
        "place": { "$ref": "defs.schema.json#/$defs/place" }
      }
    },
    "places": {
      "type": "array",
      "items": { "$ref": "defs.schema.json#/$defs/place" }
    },
    "moment": {
      "description": "A game day and pulse, the hours elapsed since the scenario began, and the clock as the events show it.",
      "type": "object",
      "required": ["day", "pulse", "elapsed_hours", "clock"],
      "additionalProperties": false,
      "properties": {
        "day": { "type": "integer" },
        "pulse": { "enum": ["night", "morning", "afternoon"] },
        "elapsed_hours": { "$ref": "defs.schema.json#/$defs/dec" },
        "clock": { "type": "string" }
      }
    },
    "moment_or_null": {
      "oneOf": [{ "$ref": "#/$defs/moment" }, { "type": "null" }]
    },
    "air_distance": {
      "type": "object",
      "required": ["format", "version", "kind", "question", "from", "to", "distance_nm"],
      "additionalProperties": false,
      "properties": {
        "format": { "const": "flagplot-agent" },
        "version": { "const": 3 },
        "kind": { "const": "measure" },
        "question": { "const": "air_distance" },
        "from": { "$ref": "#/$defs/resolved" },
        "to": { "$ref": "#/$defs/resolved" },
        "distance_nm": { "type": "integer" }
      }
    },
    "sea_route": {
      "type": "object",
      "required": [
        "format", "version", "kind", "question", "from", "to", "route_found",
        "hexes", "steps", "distance_nm"
      ],
      "additionalProperties": false,
      "properties": {
        "format": { "const": "flagplot-agent" },
        "version": { "const": 3 },
        "kind": { "const": "measure" },
        "question": { "const": "sea_route" },
        "from": { "$ref": "#/$defs/resolved" },
        "to": { "$ref": "#/$defs/resolved" },
        "route_found": { "type": "boolean" },
        "hexes": { "$ref": "#/$defs/places" },
        "steps": { "$ref": "defs.schema.json#/$defs/count_or_null" },
        "distance_nm": { "$ref": "defs.schema.json#/$defs/count_or_null" }
      }
    },
    "ship_fuel": {
      "type": "object",
      "required": [
        "ship", "class", "fuel_t", "burned_t", "left_t", "runs_dry", "runs_dry_after_nm"
      ],
      "additionalProperties": false,
      "properties": {
        "ship": { "$ref": "defs.schema.json#/$defs/handle" },
        "class": { "type": "string" },
        "fuel_t": { "$ref": "defs.schema.json#/$defs/dec" },
        "burned_t": { "$ref": "defs.schema.json#/$defs/dec" },
        "left_t": { "$ref": "defs.schema.json#/$defs/dec" },
        "runs_dry": { "type": "boolean" },
        "runs_dry_after_nm": { "$ref": "defs.schema.json#/$defs/dec_or_null" }
      }
    },
    "passage": {
      "type": "object",
      "required": [
        "format", "version", "kind", "question", "task_force", "from", "to", "order",
        "refusal", "between_hexes", "turns_back", "route_starts_at", "speed", "route",
        "route_steps", "entered_steps", "route_nm", "leaves", "outcome", "ends", "ends_at",
        "steaming_hours", "steamed_nm", "short_by_nm", "ships", "assumptions"
      ],
      "additionalProperties": false,
      "properties": {
        "format": { "const": "flagplot-agent" },
        "version": { "const": 3 },
        "kind": { "const": "measure" },
        "question": { "const": "passage" },
        "task_force": { "$ref": "defs.schema.json#/$defs/handle" },
        "from": { "$ref": "defs.schema.json#/$defs/place" },
        "to": { "$ref": "#/$defs/resolved" },
        "order": { "enum": ["accepted", "refused"] },
        "refusal": {
          "oneOf": [
            { "enum": ["no_route", "already_there", "no_ship_afloat", "out_of_fuel"] },
            { "type": "null" }
          ]
        },
        "between_hexes": { "type": "boolean" },
        "turns_back": { "type": "boolean" },
        "route_starts_at": { "$ref": "defs.schema.json#/$defs/place" },
        "speed": {
          "type": "object",
          "required": ["setting", "knots", "slowest_ship"],
          "additionalProperties": false,
          "properties": {
            "setting": { "type": "string" },
            "knots": { "$ref": "defs.schema.json#/$defs/dec" },
            "slowest_ship": { "$ref": "defs.schema.json#/$defs/handle_or_null" }
          }
        },
        "route": { "$ref": "#/$defs/places" },
        "route_steps": { "type": "integer" },
        "entered_steps": { "type": "integer" },
        "route_nm": { "$ref": "defs.schema.json#/$defs/dec" },
        "leaves": { "$ref": "#/$defs/moment" },
        "outcome": { "enum": ["arrives", "runs_out_of_fuel", "cannot_move", "does_not_sail"] },
        "ends": { "$ref": "#/$defs/moment_or_null" },
        "ends_at": { "$ref": "defs.schema.json#/$defs/place_or_null" },
        "steaming_hours": { "$ref": "defs.schema.json#/$defs/dec" },
        "steamed_nm": { "$ref": "defs.schema.json#/$defs/dec" },
        "short_by_nm": { "$ref": "defs.schema.json#/$defs/dec" },
        "ships": { "type": "array", "items": { "$ref": "#/$defs/ship_fuel" } },
        "assumptions": {
          "description": "What the forecast takes as given, in fixed words.",
          "type": "object",
          "required": ["departs", "speed", "meets", "losses", "fuel"],
          "additionalProperties": false,
          "properties": {
            "departs": { "type": "string" },
            "speed": { "type": "string" },
            "meets": { "type": "string" },
            "losses": { "type": "string" },
            "fuel": { "type": "string" }
          }
        }
      }
    },
    "yard": {
      "description": "What a send_to_yard order given now would do (decision 0069), or, for a force already away, its port and the day it is back. order and refusal are the engine's own check of the order; null when the question was not asked of a game's engine. leaves is the coming day, the day an order given now is taken in; return_day is leaves plus days_away; returns_before_end is null when the last day is not known.",
      "type": "object",
      "required": [
        "format", "version", "kind", "question", "task_force", "away", "order", "refusal",
        "port", "passage_days", "ships", "days_away", "leaves", "return_day",
        "returns_before_end", "last_day", "assumptions"
      ],
      "additionalProperties": false,
      "properties": {
        "format": { "const": "flagplot-agent" },
        "version": { "const": 3 },
        "kind": { "const": "measure" },
        "question": { "const": "yard" },
        "task_force": { "$ref": "defs.schema.json#/$defs/handle" },
        "away": { "type": "boolean" },
        "order": { "oneOf": [{ "enum": ["accepted", "refused"] }, { "type": "null" }] },
        "refusal": { "$ref": "defs.schema.json#/$defs/string_or_null" },
        "port": { "$ref": "defs.schema.json#/$defs/handle_or_null" },
        "passage_days": { "$ref": "defs.schema.json#/$defs/count_or_null" },
        "ships": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ship", "class", "flotation_damage", "systems_degraded", "systems_out",
              "days_of_repair"
            ],
            "additionalProperties": false,
            "properties": {
              "ship": { "$ref": "defs.schema.json#/$defs/handle" },
              "class": { "type": "string" },
              "flotation_damage": { "$ref": "defs.schema.json#/$defs/dec" },
              "systems_degraded": { "type": "integer" },
              "systems_out": { "type": "integer" },
              "days_of_repair": { "$ref": "defs.schema.json#/$defs/count_or_null" }
            }
          }
        },
        "days_away": { "$ref": "defs.schema.json#/$defs/count_or_null" },
        "leaves": { "$ref": "defs.schema.json#/$defs/count_or_null" },
        "return_day": { "$ref": "defs.schema.json#/$defs/count_or_null" },
        "returns_before_end": { "type": ["boolean", "null"] },
        "last_day": { "$ref": "defs.schema.json#/$defs/count_or_null" },
        "assumptions": { "type": "string" }
      }
    },
    "air_reach": {
      "type": "object",
      "required": [
        "format", "version", "kind", "question", "air_group", "at", "aircraft_type",
        "role", "radius_nm", "radius_is", "reach", "reach_nm", "escort_radius_nm", "transfer_range_nm", "places"
      ],
      "additionalProperties": false,
      "properties": {
        "format": { "const": "flagplot-agent" },
        "version": { "const": 3 },
        "kind": { "const": "measure" },
        "question": { "const": "air_reach" },
        "air_group": { "$ref": "defs.schema.json#/$defs/handle" },
        "at": { "$ref": "defs.schema.json#/$defs/place" },
        "aircraft_type": { "type": "string" },
        "role": { "enum": ["patrol", "bomber", "fighter"] },
        "radius_nm": { "$ref": "defs.schema.json#/$defs/dec" },
        "radius_is": { "enum": ["strike", "escort", "none"] },
        "reach": {
          "description": "The group's reach in force: normal (the radius applies) or extended (the longer reach applies; set by set_reach).",
          "enum": ["normal", "extended"]
        },
        "reach_nm": {
          "description": "The reach in force in miles: the radius on normal reach, and the radius and a share more, cut to a whole mile, on extended. A place is within if its distance is no more than this.",
          "$ref": "defs.schema.json#/$defs/dec"
        },
        "escort_radius_nm": { "$ref": "defs.schema.json#/$defs/dec_or_null" },
        "transfer_range_nm": {
          "description": "How far a rebase order can move the group, in miles: twice the longer of the aircraft type's search range and strike radius (decision 0091). The reach in force does not change it. A base of your side further from the group than this is refused.",
          "$ref": "defs.schema.json#/$defs/dec"
        },
        "places": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["to", "distance_nm", "within", "within_radius", "ditch_chance"],
            "additionalProperties": false,
            "properties": {
              "to": { "$ref": "#/$defs/resolved" },
              "distance_nm": { "type": "integer" },
              "within": { "description": "Within the reach in force (the radius on normal reach).", "type": "boolean" },
              "within_radius": { "description": "Within the aircraft type's radius, whatever the reach in force.", "type": "boolean" },
              "ditch_chance": {
                "description": "The chance an aircraft that came back from a strike or escort sortie to this distance runs out of fuel and is lost: \"0\" within the radius. null for a type that does not strike or where the scenario has no air combat figures.",
                "$ref": "defs.schema.json#/$defs/dec_or_null"
              }
            }
          }
        }
      }
    },
    "choices": {
      "description": "What the rules would choose now for one of the side's own air groups, task forces or land units: each question the staff asks for it, with the parameters it was asked with and the answer. Every unit, ship, base and contact is a handle of the side's own.",
      "type": "object",
      "required": ["format", "version", "kind", "question", "unit", "note", "choices"],
      "additionalProperties": false,
      "properties": {
        "format": { "const": "flagplot-agent" },
        "version": { "const": 3 },
        "kind": { "const": "measure" },
        "question": { "const": "choices" },
        "unit": { "$ref": "defs.schema.json#/$defs/handle" },
        "note": { "type": "string" },
        "choices": { "type": "array", "items": { "$ref": "#/$defs/choice_line" } }
      }
    },
    "choice_line": {
      "type": "object",
      "required": ["choice", "asked", "answer"],
      "additionalProperties": false,
      "properties": {
        "choice": {
          "enum": ["strike", "aircraft_able_to_fly", "base_strike", "fighter_split", "escort", "landing", "rest", "alert", "ready", "break_off", "stragglers", "head_home", "reroute", "halt", "steam_on", "back_to_defend", "attack_spent", "unit_day"]
        },
        "asked": { "description": "The parameters of the question; empty if it has none.", "type": "object" },
        "answer": { "description": "The answer's fields, which differ with the choice.", "type": "object" }
      }
    }
  }
}
