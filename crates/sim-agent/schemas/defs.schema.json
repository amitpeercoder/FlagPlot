{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flagplot-agent/defs",
  "title": "Shared definitions of the flagplot-agent answers, version 1",
  "$defs": {
    "dec": {
      "description": "A fixed-point quantity as an exact decimal string, such as \"12\" or \"0.25\". Never a float.",
      "type": "string",
      "format": "decimal"
    },
    "dec_or_null": {
      "type": [
        "string",
        "null"
      ],
      "format": "decimal"
    },
    "count": {
      "description": "A whole number of things.",
      "type": "integer"
    },
    "count_or_null": {
      "type": [
        "integer",
        "null"
      ]
    },
    "string_or_null": {
      "type": [
        "string",
        "null"
      ]
    },
    "handle": {
      "description": "A unit named by kind and number as the log names it, with its name when the side knows one (its own units only).",
      "type": "object",
      "required": [
        "handle",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "handle": {
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/string_or_null"
        }
      }
    },
    "handle_or_null": {
      "oneOf": [
        {
          "$ref": "#/$defs/handle"
        },
        {
          "type": "null"
        }
      ]
    },
    "handles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/handle"
      }
    },
    "place": {
      "description": "A hex, its latitude and longitude where the map has them, and the name of the side's own base there.",
      "type": "object",
      "required": [
        "q",
        "r",
        "lat",
        "lon",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "q": {
          "type": "integer"
        },
        "r": {
          "type": "integer"
        },
        "lat": {
          "$ref": "#/$defs/dec_or_null"
        },
        "lon": {
          "$ref": "#/$defs/dec_or_null"
        },
        "name": {
          "$ref": "#/$defs/string_or_null"
        }
      }
    },
    "place_or_null": {
      "oneOf": [
        {
          "$ref": "#/$defs/place"
        },
        {
          "type": "null"
        }
      ]
    },
    "event_numbers": {
      "description": "The side's own numbers of events (1, 2, 3 in the order its view gives them), as explain takes them. The log's numbers never appear.",
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "fuel_line": {
      "type": "object",
      "required": [
        "ship",
        "fuel_t",
        "range_nm"
      ],
      "additionalProperties": false,
      "properties": {
        "ship": {
          "$ref": "#/$defs/handle"
        },
        "fuel_t": {
          "$ref": "#/$defs/dec"
        },
        "range_nm": {
          "$ref": "#/$defs/count_or_null"
        }
      }
    },
    "force_line": {
      "type": "object",
      "required": [
        "task_force",
        "place",
        "status",
        "mission",
        "speed",
        "destination",
        "readiness",
        "alert",
        "fatigue",
        "ships_afloat",
        "least_fuelled",
        "movement",
        "propulsion_damaged",
        "cargo_supply_t",
        "cargo_fuel_t"
      ],
      "additionalProperties": false,
      "properties": {
        "task_force": {
          "$ref": "#/$defs/handle"
        },
        "place": {
          "$ref": "#/$defs/place"
        },
        "status": {
          "enum": [
            "idle",
            "underway",
            "arrived",
            "out_of_fuel"
          ]
        },
        "mission": {
          "enum": [
            "transport",
            "surface_combat",
            "carrier",
            "bombardment",
            "escort"
          ]
        },
        "speed": {
          "type": "string"
        },
        "destination": {
          "$ref": "#/$defs/place_or_null"
        },
        "readiness": {
          "enum": [
            "normal",
            "battle"
          ]
        },
        "alert": {
          "type": "boolean"
        },
        "fatigue": {
          "$ref": "#/$defs/dec"
        },
        "ships_afloat": {
          "type": "integer"
        },
        "least_fuelled": {
          "oneOf": [
            {
              "$ref": "#/$defs/fuel_line"
            },
            {
              "type": "null"
            }
          ]
        },
        "movement": {
          "description": "A force steams at the speed of its slowest ship. cannot_move: a ship afloat has propulsion out, so the force has no speed whatever its status and route say. slowed: a ship has propulsion degraded. normal: neither.",
          "enum": [
            "normal",
            "slowed",
            "cannot_move"
          ]
        },
        "propulsion_damaged": {
          "$ref": "#/$defs/propulsion_lines"
        },
        "cargo_supply_t": {
          "description": "Tons of supply carried as cargo, summed over the ships afloat. null unless the force carries some supply or fuel cargo or its mission is transport.",
          "$ref": "#/$defs/dec_or_null"
        },
        "cargo_fuel_t": {
          "description": "Tons of fuel carried as cargo (not the fuel the ships burn), summed over the ships afloat. null under the same condition.",
          "$ref": "#/$defs/dec_or_null"
        }
      }
    },
    "propulsion_lines": {
      "description": "The ships afloat whose propulsion is not working, each with its state.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ship",
          "propulsion"
        ],
        "additionalProperties": false,
        "properties": {
          "ship": {
            "$ref": "#/$defs/handle"
          },
          "propulsion": {
            "enum": [
              "degraded",
              "out"
            ]
          }
        }
      }
    },
    "air_group_line": {
      "type": "object",
      "required": [
        "air_group",
        "aircraft_type",
        "location",
        "place",
        "ready",
        "damaged",
        "pilots",
        "fatigue",
        "stood_down",
        "rest_above",
        "mission",
        "target",
        "strike_radius_nm",
        "search_range_nm"
      ],
      "additionalProperties": false,
      "properties": {
        "air_group": {
          "$ref": "#/$defs/handle"
        },
        "aircraft_type": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/handle"
        },
        "place": {
          "$ref": "#/$defs/place_or_null"
        },
        "ready": {
          "type": "integer"
        },
        "damaged": {
          "type": "integer"
        },
        "pilots": {
          "description": "Pilots of the group. null means the scenario does not count this group's pilots (decision 0038): no pilot limit applies and every ready aircraft can fly. A number means the group can fly no more aircraft than it has pilots.",
          "$ref": "#/$defs/count_or_null"
        },
        "fatigue": {
          "$ref": "#/$defs/dec"
        },
        "stood_down": {
          "type": "boolean"
        },
        "rest_above": {
          "$ref": "#/$defs/dec_or_null"
        },
        "mission": {
          "enum": [
            "rest",
            "search",
            "naval_strike",
            "combat_air_patrol",
            "base_strike"
          ]
        },
        "target": {
          "$ref": "#/$defs/handle_or_null"
        },
        "strike_radius_nm": {
          "description": "The aircraft type's strike radius in miles: how far from the group's place a strike can be flown (for a fighter, the radius within which its escorts go with a raid). \"0\" for a type that cannot strike.",
          "$ref": "#/$defs/dec"
        },
        "search_range_nm": {
          "description": "The aircraft type's search range in miles: the furthest a search arc can reach. \"0\" for a type that cannot search.",
          "$ref": "#/$defs/dec"
        },
        "reach_nm": {
          "description": "Given only for a group on extended reach (set_reach): the reach in force in miles, more than strike_radius_nm. Left out on normal reach, where the reach is strike_radius_nm.",
          "$ref": "#/$defs/dec"
        },
        "target_priority": {
          "description": "Given only for a group whose target list is not the default (set_target_priority): the kinds of ship its strikes go for, in order. A contact of a kind not on the list is never launched at. Left out where the list is every kind in the order carrier, battleship, cruiser, destroyer, transport, auxiliary.",
          "type": "array",
          "items": { "enum": ["carrier", "battleship", "cruiser", "destroyer", "transport", "auxiliary"] }
        }
      }
    },
    "base_line": {
      "type": "object",
      "required": [
        "base",
        "place",
        "supply_t",
        "fuel_t",
        "port_size",
        "airfield_size"
      ],
      "additionalProperties": false,
      "properties": {
        "base": {
          "$ref": "#/$defs/handle"
        },
        "place": {
          "$ref": "#/$defs/place"
        },
        "supply_t": {
          "$ref": "#/$defs/dec"
        },
        "fuel_t": {
          "$ref": "#/$defs/dec"
        },
        "port_size": {
          "description": "The map's port size of the hex, 0 where the map gives none. In the rules as built it sets only how fast cargo is worked: a port of size 0 has no berths and ships load and unload by lighter at that size's rate. Any ship may stop at a base of any size, and refuelling does not depend on it.",
          "type": "integer"
        },
        "airfield_size": {
          "description": "The map's airfield size of the hex, 0 where the map gives none. No rule reads it: a base of size 0 launches and receives air groups, repairs and is raided like any other, and no limit on the aircraft at a base follows from it.",
          "type": "integer"
        }
      }
    },
    "contact_line": {
      "type": "object",
      "required": [
        "contact",
        "place",
        "ship_count",
        "taken_for",
        "age_pulses"
      ],
      "additionalProperties": false,
      "properties": {
        "contact": {
          "$ref": "#/$defs/handle"
        },
        "place": {
          "$ref": "#/$defs/place"
        },
        "ship_count": {
          "type": "integer"
        },
        "taken_for": {
          "description": "The kind of the most important ship the sighting reported. Like ship_count it is what was reported: it can be wrong, and can change when the contact is seen again.",
          "enum": [
            "carrier",
            "battleship",
            "cruiser",
            "destroyer",
            "transport",
            "auxiliary"
          ]
        },
        "age_pulses": {
          "type": "integer"
        }
      }
    },
    "not_known": {
      "description": "The one answer for anything the side does not know of. It carries nothing of the question.",
      "type": "object",
      "required": [
        "format",
        "version",
        "kind",
        "query"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "flagplot-agent"
        },
        "version": {
          "const": 3
        },
        "kind": {
          "const": "not_known"
        },
        "query": {
          "enum": [
            "get_entity",
            "explain",
            "measure"
          ]
        }
      }
    },
    "enemy_base_line": {
      "description": "A base the side does not own, as every side knows it: number, name, place and the side that holds it. Nothing else is known of it.",
      "type": "object",
      "required": [
        "base",
        "place",
        "held_by"
      ],
      "additionalProperties": false,
      "properties": {
        "base": {
          "$ref": "#/$defs/handle"
        },
        "place": {
          "$ref": "#/$defs/place"
        },
        "held_by": {
          "enum": [
            "allied",
            "japanese"
          ]
        }
      }
    }
  }
}
