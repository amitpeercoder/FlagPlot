{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flagplot-agent/command_defs",
  "title": "Shared definitions of the answers of the staff tools (decision 0107)",
  "$defs": {
    "days": {
      "description": "The four days of a run, as the staff timed it: loading begins on load, the force sails on sail, it is due at the destination on arrive, and its ships are free (back at the source and refuelled) on free.",
      "type": "object",
      "required": [
        "load",
        "sail",
        "arrive",
        "free"
      ],
      "additionalProperties": false,
      "properties": {
        "load": {
          "type": "integer"
        },
        "sail": {
          "type": "integer"
        },
        "arrive": {
          "type": "integer"
        },
        "free": {
          "type": "integer"
        }
      }
    },
    "reading": {
      "description": "One reading of the projection: the stock at the start of the day, the planned use of that day and the figure in days of supply (null where the use is 0).",
      "type": "object",
      "required": [
        "day",
        "stock_t",
        "use_t",
        "days"
      ],
      "additionalProperties": false,
      "properties": {
        "day": {
          "type": "integer"
        },
        "stock_t": {
          "$ref": "defs.schema.json#/$defs/dec"
        },
        "use_t": {
          "$ref": "defs.schema.json#/$defs/dec"
        },
        "days": {
          "$ref": "defs.schema.json#/$defs/dec_or_null"
        }
      }
    },
    "projection_summary": {
      "type": "object",
      "required": [
        "floor_days",
        "today",
        "first_day_below_floor"
      ],
      "additionalProperties": false,
      "properties": {
        "floor_days": {
          "type": "integer"
        },
        "today": {
          "oneOf": [
            {
              "$ref": "#/$defs/reading"
            },
            {
              "type": "null"
            }
          ]
        },
        "first_day_below_floor": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "projection": {
      "type": "object",
      "required": [
        "hex",
        "floor_days",
        "today",
        "first_day_below_floor",
        "readings"
      ],
      "additionalProperties": false,
      "properties": {
        "hex": {
          "type": "object",
          "required": [
            "q",
            "r"
          ],
          "additionalProperties": false,
          "properties": {
            "q": {
              "type": "integer"
            },
            "r": {
              "type": "integer"
            }
          }
        },
        "floor_days": {
          "type": "integer"
        },
        "today": {
          "oneOf": [
            {
              "$ref": "#/$defs/reading"
            },
            {
              "type": "null"
            }
          ]
        },
        "first_day_below_floor": {
          "type": [
            "integer",
            "null"
          ]
        },
        "readings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reading"
          }
        }
      }
    },
    "reason": {
      "description": "The five parts of a staff decision: what it serves, the evidence it rests on, what binds it, the calculation and what would change it.",
      "type": "object",
      "required": [
        "serves",
        "evidence",
        "binding",
        "worked",
        "would_change"
      ],
      "additionalProperties": false,
      "properties": {
        "serves": {
          "description": "What the decision serves: the intent, the plan and the plan's amendment (left out where none), and the intent's statement: the intent in words as the commander set it and as it stood when the reason was made (left out where a reason has none). And chain: the intents above it, nearest first.",
          "type": "object",
          "required": [],
          "additionalProperties": false,
          "properties": {
            "intent": {
              "type": "integer"
            },
            "plan": {
              "type": "integer"
            },
            "amendment": {
              "type": "integer"
            },
            "statement": {
              "type": "string"
            },
            "level": {
              "description": "The level that decided (decision 0120, 2): the addressee of the intent served, \"area\", {\"base\": n} (n the base's number) or {\"task_force\": n} (n the side's number of the task force; decisions 0124 and 0125). Left out where a reason has none.",
              "oneOf": [
                {
                  "const": "area"
                },
                {
                  "type": "object",
                  "required": [
                    "base"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "base": {
                      "type": "integer"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "task_force"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "task_force": {
                      "type": "integer"
                    }
                  }
                }
              ]
            },
            "chain": {
              "type": "array",
              "description": "The intents above the one served, nearest first, each as it stood when the reason was made; the last is one you stated. Left out where the intent is a root (decision 0117, 10).",
              "items": {
                "type": "object",
                "required": [
                  "intent",
                  "maker",
                  "statement"
                ],
                "additionalProperties": false,
                "properties": {
                  "intent": {
                    "type": "integer"
                  },
                  "maker": {
                    "enum": [
                      "commander",
                      "staff"
                    ]
                  },
                  "statement": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "what",
              "day"
            ],
            "additionalProperties": false,
            "properties": {
              "what": {
                "type": "string"
              },
              "day": {
                "type": "integer"
              }
            }
          }
        },
        "binding": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "worked": {
          "type": "string"
        },
        "would_change": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "forces",
        "area",
        "priority",
        "protected",
        "risk"
      ],
      "additionalProperties": false,
      "properties": {
        "forces": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "ships",
                "task_forces",
                "air_groups",
                "land_units",
                "source"
              ],
              "additionalProperties": false,
              "properties": {
                "ships": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                },
                "task_forces": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                },
                "not_yet_available": {
                  "description": "The units of the limit whose day has not come, each with the day the side may use it from (decision 0140, 5). Left out when none.",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["unit", "available_from"],
                    "additionalProperties": false,
                    "properties": {
                      "unit": { "$ref": "defs.schema.json#/$defs/handle" },
                      "available_from": { "type": "integer", "minimum": 1 }
                    }
                  }
                },
                "source": {
                  "oneOf": [
                    {
                      "$ref": "defs.schema.json#/$defs/handle"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "air_groups": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                },
                "land_units": {
                  "type": "array",
                  "items": { "type": "integer" },
                  "description": "The side's numbers of the land units the staff may order (decision 0141)."
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "area": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        },
        "priority": {
          "type": [
            "integer",
            "null"
          ]
        },
        "protected": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "risk": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "preserve",
            "balanced",
            "press",
            null
          ],
          "description": "The risk level set on this intent itself; null where none is set (limits_read_up gives what it is read as)."
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "number",
        "ships",
        "load_t",
        "source",
        "days"
      ],
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "integer"
        },
        "ships": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "load_t": {
          "$ref": "defs.schema.json#/$defs/dec"
        },
        "source": {
          "$ref": "defs.schema.json#/$defs/handle"
        },
        "days": {
          "$ref": "#/$defs/days"
        },
        "phase": {
          "enum": [
            "waiting",
            "loading",
            "under_way",
            "returning",
            "finished"
          ]
        },
        "doing": {
          "type": "string"
        },
        "ship_states": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ship",
              "at",
              "supply_aboard_t"
            ],
            "additionalProperties": false,
            "properties": {
              "ship": {
                "type": "integer"
              },
              "at": {
                "type": "string"
              },
              "supply_aboard_t": {
                "$ref": "defs.schema.json#/$defs/dec"
              }
            }
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "number",
        "intent",
        "intent_in_force",
        "state",
        "baseline",
        "baseline_day",
        "amendments",
        "runs"
      ],
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "integer"
        },
        "intent": {
          "type": "integer"
        },
        "intent_in_force": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "draft",
            "preparing",
            "released",
            "complete",
            "failed",
            "cancelled"
          ]
        },
        "baseline": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "day",
                "kind",
                "base",
                "floor_days",
                "interval_days",
                "by_day",
                "wants",
                "defences",
                "target",
                "hex",
                "distance",
                "task_force",
                "limits"
              ],
              "additionalProperties": false,
              "properties": {
                "day": {
                  "type": "integer"
                },
                "base": {
                  "oneOf": [
                    {
                      "$ref": "defs.schema.json#/$defs/handle"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The side's own base the intent names; null for neutralise and deny."
                },
                "target": {
                  "oneOf": [
                    {
                      "$ref": "defs.schema.json#/$defs/handle"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The enemy base a neutralise or a raid is aimed at (decision 0120); null for the other kinds."
                },
                "hex": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The centre of the waters of a deny intent as [q, r] (decision 0123), the station of a stand_at or operate_carriers intent, the landing hex of a ready_landing intent or the place of a take_place intent; null for the other kinds."
                },
                "distance": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "The distance in hexes of the waters of a deny intent (decision 0123); null for the other kinds."
                },
                "task_force": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "The side's number of the task force a stand_at, operate_carriers or ready_landing intent names (decisions 0124, 0125 and 0141); null for the other kinds (a take_place has none)."
                },
                "floor_days": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "interval_days": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "by_day": {
                  "type": ["integer", "null"],
                  "description": "The morning of the day a ready_landing or take_place intent is to be ready by or to have taken the place by (decisions 0141 and 0142); null for the other kinds and for one with no date."
                },
                "wants": {
                  "oneOf": [
                    { "type": "array", "items": { "enum": ["airfield", "mend", "defences", "port", "aircraft"] } },
                    { "type": "null" }
                  ],
                  "description": "What a build_up intent wants, in order (decision 0141); null for the other kinds."
                },
                "defences": {
                  "type": ["integer", "null"],
                  "description": "The points of defences a build_up intent wants, from 1 to 100, when defences is among its wants (decision 0141); null otherwise."
                },
                "limits": {
                  "$ref": "#/$defs/limits"
                },
                "kind": {
                  "enum": [
                    "keep_supplied",
                    "cover",
                    "hold",
                    "neutralise",
                    "raid",
                    "deny",
                    "strike_ships",
                    "search_waters",
                    "stand_at",
                    "operate_carriers",
                    "ready_landing",
                    "build_up",
                    "take_place"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline_day": {
          "type": [
            "integer",
            "null"
          ]
        },
        "amendments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "number",
              "day",
              "change"
            ],
            "additionalProperties": false,
            "properties": {
              "number": {
                "type": "integer"
              },
              "day": {
                "type": "integer"
              },
              "change": {
                "type": "string"
              }
            }
          }
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run"
          }
        }
      }
    },
    "command_body": {
      "description": "A command as the interface writes it: its kind and the keys that kind has (see set_intent, form_intent (which may form keep_supplied under a hold, with floor_days, which may be 0, and an optional interval_days, decision 0144), set_limit, set_leave, hold, release, approve, cancel_plan, set_interrupt and acknowledge), ships and task forces in your numbers.",
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "set_intent",
            "withdraw_intent",
            "set_limit",
            "set_leave",
            "approve",
            "cancel_plan",
            "commit_ships",
            "free_ships",
            "add_run",
            "time_run",
            "mark_plan",
            "hold",
            "release",
            "end_run",
            "set_interrupt",
            "acknowledge",
            "form_intent"
          ]
        }
      }
    },
    "staff_order": {
      "type": "object",
      "required": [
        "unit",
        "order",
        "intent",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "unit": {
          "type": "string"
        },
        "order": {
          "type": "object"
        },
        "intent": {
          "type": "integer"
        },
        "reason": {
          "$ref": "#/$defs/reason"
        }
      }
    },
    "decisions": {
      "type": "object",
      "required": [
        "for_day",
        "orders",
        "commands",
        "no_orders"
      ],
      "additionalProperties": false,
      "properties": {
        "for_day": {
          "type": "integer"
        },
        "orders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/staff_order"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "description": "A staff command: the command's own keys, and its reason.",
            "type": "object",
            "required": [
              "kind",
              "reason"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "reason": {
                "$ref": "#/$defs/reason"
              }
            }
          }
        },
        "no_orders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reason"
          }
        },
        "notices": {
          "type": "array",
          "description": "Notices the staff hands in beside its orders: that a plan cannot meet its intent, waits for a leave, or has had a run end. Each rests on one of the commands or decisions to give no order above, by its place in the list. Left out when there is none.",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "plan",
              "run",
              "rests_on"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "cannot_meet",
                  "waits_for_leave_to_prepare",
                  "waits_for_leave_to_launch",
                  "run_ended",
                  "ready",
                  "late",
                  "met"
                ]
              },
              "plan": {
                "type": "integer"
              },
              "run": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "rests_on": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "command": {
                    "type": "integer"
                  },
                  "no_order": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    },
    "displacement": {
      "type": "object",
      "description": "A commitment to another plan that keeps an intent from a run or cuts its load: ships, or tons at the source still to be loaded, with the plan, the run and the days.",
      "required": [
        "intent",
        "plan",
        "run",
        "ships",
        "tons_t",
        "from_day",
        "to_day"
      ],
      "additionalProperties": false,
      "properties": {
        "intent": {
          "type": "integer"
        },
        "plan": {
          "type": "integer"
        },
        "run": {
          "type": "integer"
        },
        "ships": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer"
          }
        },
        "tons_t": {
          "oneOf": [
            {
              "$ref": "defs.schema.json#/$defs/dec"
            },
            {
              "type": "null"
            }
          ]
        },
        "from_day": {
          "type": "integer"
        },
        "to_day": {
          "type": "integer"
        }
      }
    },
    "hold_target": {
      "description": "What a hold keeps from the staff, in your numbers: a ship, a task force, one setting of an air group, a whole air group, or a land unit (decision 0141).",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "ship"
          ],
          "additionalProperties": false,
          "properties": {
            "ship": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "task_force"
          ],
          "additionalProperties": false,
          "properties": {
            "task_force": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "air_group",
            "setting"
          ],
          "additionalProperties": false,
          "properties": {
            "air_group": {
              "type": "integer"
            },
            "setting": {
              "enum": [
                "search_arc"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "air_group"
          ],
          "additionalProperties": false,
          "properties": {
            "air_group": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "land_unit"
          ],
          "additionalProperties": false,
          "properties": {
            "land_unit": {
              "type": "integer"
            }
          }
        }
      ]
    },
    "firing": {
      "description": "One interrupt that fired on a morning, in your numbers: a set one (interrupt, base, below_days, figure) or a standing one (standing with plan or ship). why is the numbers why takes for the reasons the notices it rests on were handed in with (empty for a set interrupt and for a ship lost); event is the firing's own number, which explain takes.",
      "type": "object",
      "required": [
        "day",
        "event",
        "acknowledged",
        "why",
        "words"
      ],
      "additionalProperties": false,
      "properties": {
        "day": {
          "type": "integer"
        },
        "event": {
          "type": "integer"
        },
        "acknowledged": {
          "type": "boolean"
        },
        "why": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "words": {
          "type": "string"
        },
        "interrupt": {
          "type": "integer"
        },
        "base": {
          "$ref": "defs.schema.json#/$defs/handle"
        },
        "below_days": {
          "type": "integer"
        },
        "figure": {
          "$ref": "defs.schema.json#/$defs/dec_or_null"
        },
        "standing": {
          "enum": [
            "cannot_meet",
            "waits_for_leave",
            "ship_lost"
          ]
        },
        "plan": {
          "type": "integer"
        },
        "ship": {
          "type": "integer"
        }
      }
    },
    "interrupts": {
      "description": "The interrupts of your command: every numbered interrupt you set, every standing record that has fired, and the standing kinds you have switched off. Those fired and not acknowledged come first.",
      "type": "object",
      "required": [
        "set",
        "standing",
        "switched_off",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "set": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "interrupt",
              "base",
              "below_days",
              "set_day",
              "armed",
              "last_fired",
              "acknowledged",
              "needs_acknowledgement",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "interrupt": {
                "type": "integer"
              },
              "base": {
                "$ref": "defs.schema.json#/$defs/handle"
              },
              "below_days": {
                "type": "integer"
              },
              "set_day": {
                "type": "integer"
              },
              "armed": {
                "type": "boolean"
              },
              "last_fired": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "acknowledged": {
                "type": "boolean"
              },
              "needs_acknowledgement": {
                "type": "boolean",
                "description": "true if it has fired and the last firing is not acknowledged."
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "standing": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "standing",
