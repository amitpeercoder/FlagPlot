{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flagplot-agent/command_defs",
  "title": "Shared definitions of the answers of the staff tools (decision 0107)",
  "$defs": {
    "days": {
      "description": "The four days of a run, as the staff timed it: loading begins on load, the force sails on sail, it is due at the destination on arrive, and its ships are free (back at the source and refuelled) on free.",
      "type": "object",
      "required": [
        "load",
        "sail",
        "arrive",
        "free"
      ],
      "additionalProperties": false,
      "properties": {
        "load": {
          "type": "integer"
        },
        "sail": {
          "type": "integer"
        },
        "arrive": {
          "type": "integer"
        },
        "free": {
          "type": "integer"
        }
      }
    },
    "reading": {
      "description": "One reading of the projection: the stock at the start of the day, the planned use of that day and the figure in days of supply (null where the use is 0).",
      "type": "object",
      "required": [
        "day",
        "stock_t",
        "use_t",
        "days"
      ],
      "additionalProperties": false,
      "properties": {
        "day": {
          "type": "integer"
        },
        "stock_t": {
          "$ref": "defs.schema.json#/$defs/dec"
        },
        "use_t": {
          "$ref": "defs.schema.json#/$defs/dec"
        },
        "days": {
          "$ref": "defs.schema.json#/$defs/dec_or_null"
        }
      }
    },
    "projection_summary": {
      "type": "object",
      "required": [
        "floor_days",
        "today",
        "first_day_below_floor"
      ],
      "additionalProperties": false,
      "properties": {
        "floor_days": {
          "type": "integer"
        },
        "today": {
          "oneOf": [
            {
              "$ref": "#/$defs/reading"
            },
            {
              "type": "null"
            }
          ]
        },
        "first_day_below_floor": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "projection": {
      "type": "object",
      "required": [
        "hex",
        "floor_days",
        "today",
        "first_day_below_floor",
        "readings"
      ],
      "additionalProperties": false,
      "properties": {
        "hex": {
          "type": "object",
          "required": [
            "q",
            "r"
          ],
          "additionalProperties": false,
          "properties": {
            "q": {
              "type": "integer"
            },
            "r": {
              "type": "integer"
            }
          }
        },
        "floor_days": {
          "type": "integer"
        },
        "today": {
          "oneOf": [
            {
              "$ref": "#/$defs/reading"
            },
            {
              "type": "null"
            }
          ]
        },
        "first_day_below_floor": {
          "type": [
            "integer",
            "null"
          ]
        },
        "readings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reading"
          }
        }
      }
    },
    "reason": {
      "description": "The five parts of a staff decision: what it serves, the evidence it rests on, what binds it, the calculation and what would change it.",
      "type": "object",
      "required": [
        "serves",
        "evidence",
        "binding",
        "worked",
        "would_change"
      ],
      "additionalProperties": false,
      "properties": {
        "serves": {
          "description": "What the decision serves: the intent, the plan and the plan's amendment (left out where none), and the intent's statement: the intent in words as the commander set it and as it stood when the reason was made (left out where a reason has none). And chain: the intents above it, nearest first.",
          "type": "object",
          "required": [],
          "additionalProperties": false,
          "properties": {
            "intent": {
              "type": "integer"
            },
            "plan": {
              "type": "integer"
            },
            "amendment": {
              "type": "integer"
            },
            "statement": {
              "type": "string"
            },
            "chain": {
              "type": "array",
              "description": "The intents above the one served, nearest first, each as it stood when the reason was made; the last is one you stated. Left out where the intent is a root (decision 0117, 10).",
              "items": {
                "type": "object",
                "required": [
                  "intent",
                  "maker",
                  "statement"
                ],
                "additionalProperties": false,
                "properties": {
                  "intent": {
                    "type": "integer"
                  },
                  "maker": {
                    "enum": [
                      "commander",
                      "staff"
                    ]
                  },
                  "statement": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "what",
              "day"
            ],
            "additionalProperties": false,
            "properties": {
              "what": {
                "type": "string"
              },
              "day": {
                "type": "integer"
              }
            }
          }
        },
        "binding": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "worked": {
          "type": "string"
        },
        "would_change": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "forces",
        "area",
        "priority",
        "protected",
        "risk"
      ],
      "additionalProperties": false,
      "properties": {
        "forces": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "ships",
                "task_forces",
                "air_groups",
                "source"
              ],
              "additionalProperties": false,
              "properties": {
                "ships": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                },
                "task_forces": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                },
                "source": {
                  "oneOf": [
                    {
                      "$ref": "defs.schema.json#/$defs/handle"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "air_groups": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "area": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        },
        "priority": {
          "type": [
            "integer",
            "null"
          ]
        },
        "protected": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "risk": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "preserve",
            "balanced",
            "press",
            null
          ],
          "description": "The risk level set on this intent itself; null where none is set (limits_read_up gives what it is read as)."
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "number",
        "ships",
        "load_t",
        "source",
        "days"
      ],
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "integer"
        },
        "ships": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "load_t": {
          "$ref": "defs.schema.json#/$defs/dec"
        },
        "source": {
          "$ref": "defs.schema.json#/$defs/handle"
        },
        "days": {
          "$ref": "#/$defs/days"
        },
        "phase": {
          "enum": [
            "waiting",
            "loading",
            "under_way",
            "returning",
            "finished"
          ]
        },
        "doing": {
          "type": "string"
        },
        "ship_states": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ship",
              "at",
              "supply_aboard_t"
            ],
            "additionalProperties": false,
            "properties": {
              "ship": {
                "type": "integer"
              },
              "at": {
                "type": "string"
              },
              "supply_aboard_t": {
                "$ref": "defs.schema.json#/$defs/dec"
              }
            }
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "number",
        "intent",
        "intent_in_force",
        "state",
        "baseline",
        "baseline_day",
        "amendments",
        "runs"
      ],
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "integer"
        },
        "intent": {
          "type": "integer"
        },
        "intent_in_force": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "draft",
            "preparing",
            "released",
            "complete",
            "failed",
            "cancelled"
          ]
        },
        "baseline": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "day",
                "kind",
                "base",
                "floor_days",
                "interval_days",
                "limits"
              ],
              "additionalProperties": false,
              "properties": {
                "day": {
                  "type": "integer"
                },
                "base": {
                  "$ref": "defs.schema.json#/$defs/handle"
                },
                "floor_days": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "interval_days": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "limits": {
                  "$ref": "#/$defs/limits"
                },
                "kind": {
                  "enum": [
                    "keep_supplied",
                    "cover",
                    "hold"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline_day": {
          "type": [
            "integer",
            "null"
          ]
        },
        "amendments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "number",
              "day",
              "change"
            ],
            "additionalProperties": false,
            "properties": {
              "number": {
                "type": "integer"
              },
              "day": {
                "type": "integer"
              },
              "change": {
                "type": "string"
              }
            }
          }
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run"
          }
        }
      }
    },
    "command_body": {
      "description": "A command as the interface writes it: its kind and the keys that kind has (see set_intent, form_intent, set_limit, set_leave, hold, release, approve, cancel_plan, set_interrupt and acknowledge), ships and task forces in your numbers.",
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "set_intent",
            "withdraw_intent",
            "set_limit",
            "set_leave",
            "approve",
            "cancel_plan",
            "commit_ships",
            "free_ships",
            "add_run",
            "time_run",
            "mark_plan",
            "hold",
            "release",
            "end_run",
            "set_interrupt",
            "acknowledge",
            "form_intent"
          ]
        }
      }
    },
    "staff_order": {
      "type": "object",
      "required": [
        "unit",
        "order",
        "intent",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "unit": {
          "type": "string"
        },
        "order": {
          "type": "object"
        },
        "intent": {
          "type": "integer"
        },
        "reason": {
          "$ref": "#/$defs/reason"
        }
      }
    },
    "decisions": {
      "type": "object",
      "required": [
        "for_day",
        "orders",
        "commands",
        "no_orders"
      ],
      "additionalProperties": false,
      "properties": {
        "for_day": {
          "type": "integer"
        },
        "orders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/staff_order"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "description": "A staff command: the command's own keys, and its reason.",
            "type": "object",
            "required": [
              "kind",
              "reason"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "reason": {
                "$ref": "#/$defs/reason"
              }
            }
          }
        },
        "no_orders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reason"
          }
        },
        "notices": {
          "type": "array",
          "description": "Notices the staff hands in beside its orders: that a plan cannot meet its intent, waits for a leave, or has had a run end. Each rests on one of the commands or decisions to give no order above, by its place in the list. Left out when there is none.",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "plan",
              "run",
              "rests_on"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "cannot_meet",
                  "waits_for_leave_to_prepare",
                  "waits_for_leave_to_launch",
                  "run_ended"
                ]
              },
              "plan": {
                "type": "integer"
              },
              "run": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "rests_on": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "command": {
                    "type": "integer"
                  },
                  "no_order": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    },
    "displacement": {
      "type": "object",
      "description": "A commitment to another plan that keeps an intent from a run or cuts its load: ships, or tons at the source still to be loaded, with the plan, the run and the days.",
      "required": [
        "intent",
        "plan",
        "run",
        "ships",
        "tons_t",
        "from_day",
        "to_day"
      ],
      "additionalProperties": false,
      "properties": {
        "intent": {
          "type": "integer"
        },
        "plan": {
          "type": "integer"
        },
        "run": {
          "type": "integer"
        },
        "ships": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer"
          }
        },
        "tons_t": {
          "oneOf": [
            {
              "$ref": "defs.schema.json#/$defs/dec"
            },
            {
              "type": "null"
            }
          ]
        },
        "from_day": {
          "type": "integer"
        },
        "to_day": {
          "type": "integer"
        }
      }
    },
    "hold_target": {
      "description": "What a hold keeps from the staff, in your numbers: a ship, a task force, one setting of an air group, or a whole air group.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "ship"
          ],
          "additionalProperties": false,
          "properties": {
            "ship": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "task_force"
          ],
          "additionalProperties": false,
          "properties": {
            "task_force": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "air_group",
            "setting"
          ],
          "additionalProperties": false,
          "properties": {
            "air_group": {
              "type": "integer"
            },
            "setting": {
              "enum": [
                "search_arc"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "air_group"
          ],
          "additionalProperties": false,
          "properties": {
            "air_group": {
              "type": "integer"
            }
          }
        }
      ]
    },
    "firing": {
      "description": "One interrupt that fired on a morning, in your numbers: a set one (interrupt, base, below_days, figure) or a standing one (standing with plan or ship). why is the numbers why takes for the reasons the notices it rests on were handed in with (empty for a set interrupt and for a ship lost); event is the firing's own number, which explain takes.",
      "type": "object",
      "required": [
        "day",
        "event",
        "acknowledged",
        "why",
        "words"
      ],
      "additionalProperties": false,
      "properties": {
        "day": {
          "type": "integer"
        },
        "event": {
          "type": "integer"
        },
        "acknowledged": {
          "type": "boolean"
        },
        "why": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "words": {
          "type": "string"
        },
        "interrupt": {
          "type": "integer"
        },
        "base": {
          "$ref": "defs.schema.json#/$defs/handle"
        },
        "below_days": {
          "type": "integer"
        },
        "figure": {
          "$ref": "defs.schema.json#/$defs/dec_or_null"
        },
        "standing": {
          "enum": [
            "cannot_meet",
            "waits_for_leave",
            "ship_lost"
          ]
        },
        "plan": {
          "type": "integer"
        },
        "ship": {
          "type": "integer"
        }
      }
    },
    "interrupts": {
      "description": "The interrupts of your command: every numbered interrupt you set, every standing record that has fired, and the standing kinds you have switched off. Those fired and not acknowledged come first.",
      "type": "object",
      "required": [
        "set",
        "standing",
        "switched_off",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "set": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "interrupt",
              "base",
              "below_days",
              "set_day",
              "armed",
              "last_fired",
              "acknowledged",
              "needs_acknowledgement",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "interrupt": {
                "type": "integer"
              },
              "base": {
                "$ref": "defs.schema.json#/$defs/handle"
              },
              "below_days": {
                "type": "integer"
              },
              "set_day": {
                "type": "integer"
              },
              "armed": {
                "type": "boolean"
              },
              "last_fired": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "acknowledged": {
                "type": "boolean"
              },
              "needs_acknowledgement": {
                "type": "boolean",
                "description": "true if it has fired and the last firing is not acknowledged."
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "standing": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "standing",
              "armed",
              "last_fired",
              "acknowledged",
              "needs_acknowledgement",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "standing": {
                "enum": [
                  "cannot_meet",
                  "waits_for_leave",
                  "ship_lost"
                ]
              },
              "plan": {
                "type": "integer"
              },
              "ship": {
                "type": "integer"
              },
              "armed": {
                "type": "boolean"
              },
              "last_fired": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "acknowledged": {
                "type": "boolean"
              },
              "needs_acknowledgement": {
                "type": "boolean",
                "description": "true if it has fired and the last firing is not acknowledged."
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "switched_off": {
          "type": "array",
          "items": {
            "enum": [
              "cannot_meet",
              "waits_for_leave",
              "ship_lost"
            ]
          }
        },
        "text": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "One line for each interrupt, record and switched-off kind, those fired and not acknowledged first."
        }
      }
    },
    "limits_read_up": {
      "type": "object",
      "description": "An intent's limits as the staff reads them, up the tree: each limit's value, the intent it is read from, and for forces and risk what holds where none is set (decision 0117, 7 and 8).",
      "required": [
        "forces",
        "forces_from",
        "forces_if_unset",
        "risk",
        "risk_from",
        "risk_set",
        "risk_if_unset",
        "area",
        "area_from",
        "priority",
        "priority_from"
      ],
      "additionalProperties": false,
      "properties": {
        "forces": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "ships",
                "task_forces",
                "air_groups",
                "source"
              ],
              "additionalProperties": false,
              "properties": {
                "ships": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                },
                "task_forces": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                },
                "source": {
                  "oneOf": [
                    {
                      "$ref": "defs.schema.json#/$defs/handle"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "air_groups": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "forces_from": {
          "type": [
            "integer",
            "null"
          ]
        },
        "forces_if_unset": {
          "type": [
            "string",
            "null"
          ]
        },
        "risk": {
          "enum": [
            "preserve",
            "balanced",
            "press"
          ]
        },
        "risk_from": {
          "type": [
            "integer",
            "null"
          ]
        },
        "risk_set": {
          "type": "boolean"
        },
        "risk_if_unset": {
          "type": [
            "string",
            "null"
          ]
        },
        "area": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        },
        "area_from": {
          "type": [
            "integer",
            "null"
          ]
        },
        "priority": {
          "type": [
            "integer",
            "null"
          ]
        },
        "priority_from": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "hold_measure": {
      "type": "object",
      "description": "The measure of a hold intent (decision 0117, 14): the days it has been in force and the days of them the base was the side's at the end of the day with its airfield open, the air raids on the base in those days and how many a patrol of the side's fought, the base's days of supply today (null where no figure), and the words.",
      "required": [
        "days_in_force",
