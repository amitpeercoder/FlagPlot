{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flagplot-agent/entity",
  "title": "entity: everything the side knows of one own unit or one contact (get_entity); or not_known",
  "oneOf": [
    {
      "$ref": "#/$defs/entity"
    },
    {
      "$ref": "defs.schema.json#/$defs/not_known"
    }
  ],
  "$defs": {
    "entity": {
      "type": "object",
      "required": [
        "format",
        "version",
        "kind",
        "entity"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "flagplot-agent"
        },
        "version": {
          "const": 3
        },
        "kind": {
          "const": "entity"
        },
        "entity": {
          "oneOf": [
            {
              "$ref": "#/$defs/ship"
            },
            {
              "$ref": "#/$defs/task_force"
            },
            {
              "$ref": "#/$defs/air_group"
            },
            {
              "$ref": "#/$defs/land_unit"
            },
            {
              "$ref": "#/$defs/base"
            },
            {
              "$ref": "#/$defs/contact"
            },
            {
              "$ref": "#/$defs/enemy_base"
            }
          ]
        }
      }
    },
    "system_state": {
      "enum": [
        "working",
        "degraded",
        "out"
      ]
    },
    "systems": {
      "type": "object",
      "required": [
        "propulsion",
        "fire_control",
        "main_battery",
        "torpedo_mounts",
        "flight_deck"
      ],
      "additionalProperties": false,
      "properties": {
        "propulsion": {
          "$ref": "#/$defs/system_state"
        },
        "fire_control": {
          "$ref": "#/$defs/system_state"
        },
        "main_battery": {
          "$ref": "#/$defs/system_state"
        },
        "torpedo_mounts": {
          "$ref": "#/$defs/system_state"
        },
        "flight_deck": {
          "$ref": "#/$defs/system_state"
        }
      }
    },
    "ship": {
      "type": "object",
      "required": [
        "entity_kind",
        "ship",
        "class",
        "ship_kind",
        "sunk",
        "task_force",
        "port",
        "place",
        "fuel_t",
        "supply_t",
        "cargo_fuel_t",
        "flotation_damage",
        "fire_damage",
        "gun_rounds",
        "torpedoes_ready",
        "systems",
        "range_nm",
        "air_groups"
      ],
      "additionalProperties": false,
      "properties": {
        "entity_kind": {
          "const": "ship"
        },
        "ship": {
          "$ref": "defs.schema.json#/$defs/handle"
        },
        "class": {
          "type": "string"
        },
        "ship_kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "carrier",
            "battleship",
            "cruiser",
            "destroyer",
            "transport",
            "auxiliary",
            null
          ]
        },
        "sunk": {
          "type": "boolean"
        },
        "task_force": {
          "$ref": "defs.schema.json#/$defs/handle_or_null"
        },
        "port": {
          "$ref": "defs.schema.json#/$defs/handle_or_null"
        },
        "place": {
          "$ref": "defs.schema.json#/$defs/place_or_null"
        },
        "fuel_t": {
          "$ref": "defs.schema.json#/$defs/dec"
        },
        "supply_t": {
          "$ref": "defs.schema.json#/$defs/dec"
        },
        "cargo_fuel_t": {
          "$ref": "defs.schema.json#/$defs/dec"
        },
        "flotation_damage": {
          "$ref": "defs.schema.json#/$defs/dec"
        },
        "fire_damage": {
          "$ref": "defs.schema.json#/$defs/dec"
        },
        "gun_rounds": {
          "$ref": "defs.schema.json#/$defs/dec"
        },
        "torpedoes_ready": {
          "type": "boolean"
        },
        "systems": {
          "$ref": "#/$defs/systems"
        },
        "experience": {
          "description": "The crew's experience, 0 to 4, present only when it is not the standard 2 (decision 0064).",
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "range_nm": {
          "$ref": "defs.schema.json#/$defs/count_or_null"
        },
        "air_groups": {
          "$ref": "defs.schema.json#/$defs/handles"
        },
        "troops": {
          "$ref": "#/$defs/troops"
        }
      }
    },
    "troops": {
      "description": "The men of a land unit a ship carries (decision 0066, 21). Present only when she carries men.",
      "type": "object",
      "required": ["land_unit", "men"],
      "additionalProperties": false,
      "properties": {
        "land_unit": { "$ref": "defs.schema.json#/$defs/handle" },
        "men": { "type": "integer" }
      }
    },
    "land_unit": {
      "type": "object",
      "required": ["entity_kind", "summary"],
      "additionalProperties": false,
      "properties": {
        "entity_kind": { "const": "land_unit" },
        "summary": { "$ref": "defs.schema.json#/$defs/land_unit_line" }
      }
    },
    "ship_line": {
      "type": "object",
      "required": [
        "ship",
        "class",
        "sunk",
        "fuel_t",
        "flotation_damage",
        "fire_damage"
      ],
      "additionalProperties": false,
      "properties": {
        "ship": {
          "$ref": "defs.schema.json#/$defs/handle"
        },
        "class": {
          "type": "string"
        },
        "sunk": {
          "type": "boolean"
        },
        "fuel_t": {
          "$ref": "defs.schema.json#/$defs/dec"
        },
        "flotation_damage": {
          "$ref": "defs.schema.json#/$defs/dec"
        },
        "fire_damage": {
          "$ref": "defs.schema.json#/$defs/dec"
        },
        "experience": {
          "description": "The crew's experience, 0 to 4, present only when it is not the standard 2 (decision 0064).",
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "troops": {
          "$ref": "#/$defs/troops"
        }
      }
    },
    "task_force": {
      "type": "object",
      "required": [
        "entity_kind",
        "summary",
        "route",
        "next_waypoint",
        "stance",
        "break_off",
        "home_port",
        "ships"
      ],
      "additionalProperties": false,
      "properties": {
        "entity_kind": {
          "const": "task_force"
        },
        "summary": {
          "$ref": "defs.schema.json#/$defs/force_line"
        },
        "route": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/place"
          }
        },
        "next_waypoint": {
          "type": "integer"
        },
        "stance": {
          "enum": [
            "engage",
            "avoid"
          ]
        },
        "break_off": {
          "$ref": "defs.schema.json#/$defs/dec"
        },
        "home_port": {
          "$ref": "defs.schema.json#/$defs/handle_or_null"
        },
        "ships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ship_line"
          }
        }
      }
    },
    "air_group": {
      "type": "object",
      "required": [
        "entity_kind",
        "summary",
        "patrol_share",
        "strength",
        "search_from_deg",
        "search_to_deg",
        "search_range_nm"
      ],
      "additionalProperties": false,
      "properties": {
        "entity_kind": {
          "const": "air_group"
        },
        "summary": {
          "$ref": "defs.schema.json#/$defs/air_group_line"
        },
        "patrol_share": {
          "description": "The share of the group kept over its own hex: 1 keeps every fighter at home and sends no escort; 0.5 keeps half and lets half escort raids.",
          "$ref": "defs.schema.json#/$defs/dec"
        },
        "strength": {
          "type": "integer"
        },
        "search_from_deg": {
          "$ref": "defs.schema.json#/$defs/count_or_null"
        },
        "search_to_deg": {
          "$ref": "defs.schema.json#/$defs/count_or_null"
        },
        "search_range_nm": {
          "$ref": "defs.schema.json#/$defs/dec_or_null"
        }
      }
    },
    "base": {
      "type": "object",
      "required": [
        "entity_kind",
        "summary",
        "anti_aircraft",
        "aircraft_repairs_per_day",
        "air_groups",
        "ships_in_port"
      ],
      "additionalProperties": false,
      "properties": {
        "entity_kind": {
          "const": "base"
        },
        "summary": {
          "$ref": "defs.schema.json#/$defs/base_line"
        },
        "anti_aircraft": {
          "type": "integer"
        },
        "aircraft_repairs_per_day": {
          "type": "integer"
        },
        "air_groups": {
          "$ref": "defs.schema.json#/$defs/handles"
        },
        "ships_in_port": {
          "$ref": "defs.schema.json#/$defs/handles"
        }
      }
    },
    "contact": {
      "type": "object",
      "required": [
        "entity_kind",
        "summary",
        "last_report_event"
      ],
      "additionalProperties": false,
      "properties": {
        "entity_kind": {
          "const": "contact"
        },
        "summary": {
          "$ref": "defs.schema.json#/$defs/contact_line"
        },
        "last_report_event": {
          "$ref": "defs.schema.json#/$defs/count_or_null"
        }
      }
    },
    "enemy_base": {
      "type": "object",
      "required": [
        "entity_kind",
        "summary",
        "known"
      ],
      "additionalProperties": false,
      "properties": {
        "entity_kind": {
          "const": "enemy_base"
        },
        "summary": {
          "$ref": "defs.schema.json#/$defs/enemy_base_line"
        },
        "known": {
          "const": "number, name, place and holder only"
        }
      }
    }
  }
}
