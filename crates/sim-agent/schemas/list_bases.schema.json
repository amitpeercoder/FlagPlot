{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flagplot-agent/list_bases",
  "title": "list_bases: a line for each base",
  "type": "object",
  "required": [
    "format",
    "version",
    "kind",
    "area",
    "bases",
    "enemy_bases"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "flagplot-agent"
    },
    "version": {
      "const": 10
    },
    "kind": {
      "const": "list_bases"
    },
    "area": {
      "$ref": "#/$defs/area_or_null"
    },
    "bases": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/base_line"
      }
    },
    "shared_hexes": {
      "description": "Each hex in the area where the side holds more than one base, shown as one place (decision 0110, item 8): the stock of all its bases and the days of supply for the hex, once. The bases are still listed in bases. Left out when no hex holds more than one.",
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/shared_hex"
      }
    },
    "enemy_bases": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/enemy_base_line"
      }
    }
  },
  "$defs": {
    "area_or_null": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "q",
            "r",
            "radius_nm"
          ],
          "additionalProperties": false,
          "properties": {
            "q": {
              "type": "integer"
            },
            "r": {
              "type": "integer"
            },
            "radius_nm": {
              "type": "integer"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
