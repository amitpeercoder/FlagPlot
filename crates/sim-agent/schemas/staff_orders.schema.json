{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flagplot-agent/staff_orders",
  "title": "staff_orders: what the staff would hand in for the coming day",
  "description": "The orders (unit and order in your numbers), the commands and the decisions to give no order the staff would hand in at the start of the coming day, each with its reason in five parts. It asks the staff on the state as the coming day will find it, with the commands you have queued taken in.",
  "type": "object",
  "required": [
    "format",
    "version",
    "kind",
    "for_day",
    "orders",
    "commands",
    "no_orders",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "inside_day": {
      "type": "string",
      "description": "Given only at 0600 or 1200, in a game that stops between pulses (decision 0156): the answer was worked on the state as it stands, as if the open day were closed now, before the rest of the day, its fight ashore and its end are resolved; a command is checked again when it is taken in at the next dusk."
    },
    "format": {
      "const": "flagplot-agent"
    },
    "version": {
      "const": 55
    },
    "kind": {
      "const": "staff_orders"
    },
    "for_day": {
      "type": "integer"
    },
    "orders": {
      "type": "array",
      "items": {
        "$ref": "command_defs.schema.json#/$defs/staff_order"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "description": "A staff command: the command's own keys, and its reason.",
        "type": "object",
        "required": [
          "kind",
          "reason"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "reason": {
            "$ref": "command_defs.schema.json#/$defs/reason"
          }
        }
      }
    },
    "no_orders": {
      "type": "array",
      "items": {
        "$ref": "command_defs.schema.json#/$defs/reason"
      }
    },
    "summary": {
      "type": "string"
    },
    "notices": {
      "type": "array",
      "description": "Notices the staff hands in beside its orders: that a plan cannot meet its intent, waits for a leave, or has had a run end. Each rests on one of the commands or decisions to give no order above, by its place in the list. Left out when there is none.",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "plan",
          "run",
          "rests_on"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "cannot_meet",
              "waits_for_leave_to_prepare",
              "waits_for_leave_to_launch",
              "run_ended",
              "ready",
              "late",
              "met",
              "cannot_bring_enough",
              "lift_turned_back",
              "asks_leave_to_pursue",
              "pursues",
              "pursuit_ended"
            ]
          },
          "plan": {
            "type": "integer"
          },
          "run": {
            "type": [
              "integer",
              "null"
            ]
          },
          "pursuit": {
            "$ref": "command_defs.schema.json#/$defs/staff_notice_pursuit"
          },
          "rests_on": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "command": {
                "type": "integer"
              },
              "no_order": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  }
}
