              "men": { "type": "integer" },
              "fed": { "type": "integer" },
              "unfed": { "type": "integer" },
              "event": { "type": "integer" }
            }
          }
        },
        "lost_yesterday": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["land_unit", "cause", "men", "ship", "place", "ashore", "event"],
            "additionalProperties": false,
            "properties": {
              "land_unit": { "$ref": "defs.schema.json#/$defs/handle" },
              "cause": { "enum": ["unfed", "lost_with_ship"] },
              "men": { "type": "integer" },
              "ship": { "description": "The ship lost with, for lost_with_ship.", "$ref": "defs.schema.json#/$defs/handle_or_null" },
              "place": { "description": "The hex of an unfed loss.", "$ref": "defs.schema.json#/$defs/place_or_null" },
              "ashore": { "description": "What the unit has left ashore there, for unfed.", "$ref": "defs.schema.json#/$defs/count_or_null" },
              "event": { "type": "integer" }
            }
          }
        },
        "destroyed_yesterday": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["land_unit", "event"],
            "additionalProperties": false,
            "properties": {
              "land_unit": { "$ref": "defs.schema.json#/$defs/handle" },
              "event": { "type": "integer" }
            }
          }
        },
        "supply_by_hex": {
          "description": "For each hex with men of the side ashore: the base that feeds them (the side's lowest-numbered there), the aircraft at it, its stock, what the aircraft and the men cost it a day, and the days it lasts at that charge (truncated to one decimal; null without a base or with no charge).",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["place", "men_ashore", "base", "aircraft", "supply_t", "daily_charge_t", "days_of_supply"],
            "additionalProperties": false,
            "properties": {
              "place": { "$ref": "defs.schema.json#/$defs/place" },
              "men_ashore": { "type": "integer" },
              "base": { "$ref": "defs.schema.json#/$defs/handle_or_null" },
              "aircraft": { "type": "integer" },
              "supply_t": { "$ref": "defs.schema.json#/$defs/dec_or_null" },
              "daily_charge_t": { "$ref": "defs.schema.json#/$defs/dec" },
