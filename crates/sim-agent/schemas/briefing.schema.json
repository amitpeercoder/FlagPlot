      }
    },
    "repaired_ship": {
      "description": "A ship a base mended yesterday by forward repair (decision 0069): the points spent on her, what she has left of fire and flotation damage, the systems put back to working yesterday, and the systems she still has degraded or out.",
      "type": "object",
      "required": [
        "ship", "task_force", "points", "fire_damage", "flotation_damage", "restored",
        "systems_degraded", "systems_out", "event"
      ],
