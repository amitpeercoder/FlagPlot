        "returned_yesterday": { "type": "array", "items": { "$ref": "#/$defs/returned_force" } },
        "stocks_yesterday": {
          "description": "Where the base's supply and fuel went and came from yesterday, by cause, from the side's own events. null when nothing moved in or out of either stock; otherwise supply and fuel are each null when that stock did not move. start_t is end_t less the net of the causes (landed less the others).",
          "oneOf": [
            {
              "type": "object",
              "required": ["supply", "fuel"],
              "additionalProperties": false,
              "properties": {
                "supply": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "start_t", "end_t", "landed_t", "loaded_onto_ships_t",
                        "sorties_and_upkeep_t", "repairs_t", "destroyed_by_raids_t"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "start_t": { "$ref": "defs.schema.json#/$defs/dec" },
                        "end_t": { "$ref": "defs.schema.json#/$defs/dec" },
                        "landed_t": { "description": "Put ashore by ships.", "$ref": "defs.schema.json#/$defs/dec" },
                        "loaded_onto_ships_t": { "description": "Taken aboard ships as cargo.", "$ref": "defs.schema.json#/$defs/dec" },
                        "sorties_and_upkeep_t": { "description": "Paid for sorties flown and aircraft kept at the base.", "$ref": "defs.schema.json#/$defs/dec" },
                        "repairs_t": { "$ref": "defs.schema.json#/$defs/dec" },
                        "destroyed_by_raids_t": { "$ref": "defs.schema.json#/$defs/dec" },
                        "men_fed_t": { "description": "Paid to feed men ashore (decision 0066, 16). Present only when something was paid for men.", "$ref": "defs.schema.json#/$defs/dec" }
                      }
                    },
                    { "type": "null" }
                  ]
                },
                "fuel": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "start_t", "end_t", "landed_t", "loaded_onto_ships_t", "refuelling_ships_t"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "start_t": { "$ref": "defs.schema.json#/$defs/dec" },
                        "end_t": { "$ref": "defs.schema.json#/$defs/dec" },
                        "landed_t": { "description": "Put ashore by ships.", "$ref": "defs.schema.json#/$defs/dec" },
                        "loaded_onto_ships_t": { "description": "Taken aboard ships as cargo.", "$ref": "defs.schema.json#/$defs/dec" },
                        "refuelling_ships_t": { "description": "Taken by ships to fill their own tanks.", "$ref": "defs.schema.json#/$defs/dec" }
                      }
                    },
                    { "type": "null" }
                  ]
                }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
