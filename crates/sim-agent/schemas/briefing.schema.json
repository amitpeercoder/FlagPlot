              "pilots": { "type": "integer" },
              "ready": { "type": "integer" }
            }
          }
        },
        "air_group_tired": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["air_group", "fatigue", "rest_above", "stood_down"],
