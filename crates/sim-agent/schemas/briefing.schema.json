              "from": { "description": "The unit that kept its men ashore elsewhere.", "$ref": "defs.schema.json#/$defs/handle" },
              "land_unit": { "description": "The new unit made of the men aboard.", "$ref": "defs.schema.json#/$defs/handle" },
