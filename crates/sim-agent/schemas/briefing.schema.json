              "stood_down": { "type": "boolean" }
            }
          }
        },
        "task_force_propulsion": {
          "description": "Task forces with a ship afloat whose propulsion is degraded or out. A force steams at the speed of its slowest ship, so a ship with propulsion out stops the whole force (effect cannot_move) and one degraded slows it (effect slowed).",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["task_force", "effect", "ships"],
            "additionalProperties": false,
            "properties": {
              "task_force": { "$ref": "defs.schema.json#/$defs/handle" },
              "effect": { "enum": ["cannot_move", "slowed"] },
              "ships": { "$ref": "defs.schema.json#/$defs/propulsion_lines" }
            }
          }
        },
        "strike_group_out_of_reach": {
          "description": "An own air group on naval_strike that holds contacts but has none within its aircraft type's strike radius, or on base_strike at a base beyond it, at the time of the briefing: it would launch nothing. nearest is the nearest contact held (naval_strike) or the target base (base_strike); distance_nm is its air distance, the figure measure air_reach gives.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["air_group", "mission", "radius_nm", "nearest", "distance_nm"],
            "additionalProperties": false,
            "properties": {
              "air_group": { "$ref": "defs.schema.json#/$defs/handle" },
              "mission": { "enum": ["naval_strike", "base_strike"] },
              "radius_nm": { "$ref": "defs.schema.json#/$defs/dec" },
              "reach_nm": {
                "description": "Given only for a group on extended reach: the reach in force in miles. The warning is made against it, not against radius_nm: a contact within it does not warn.",
                "$ref": "defs.schema.json#/$defs/dec"
              },
              "nearest": { "$ref": "defs.schema.json#/$defs/handle" },
              "distance_nm": { "type": "integer" }
            }
          }
        },
        "strike_group_holding": {
          "description": "Left out when there is none. An own air group on naval_strike that holds contacts within its reach, none of a kind on its target list (set_target_priority): it holds its strike and launches nothing at them. nearest is the nearest contact within reach and nearest_taken_for the kind it is taken for; distance_nm is its air distance.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["air_group", "target_priority", "radius_nm", "nearest", "nearest_taken_for", "distance_nm"],
            "additionalProperties": false,
            "properties": {
              "air_group": { "$ref": "defs.schema.json#/$defs/handle" },
              "target_priority": {
                "type": "array",
                "items": { "enum": ["carrier", "battleship", "cruiser", "destroyer", "transport", "auxiliary"] }
              },
              "radius_nm": { "$ref": "defs.schema.json#/$defs/dec" },
              "reach_nm": {
                "description": "Given only for a group on extended reach: the reach in force in miles.",
                "$ref": "defs.schema.json#/$defs/dec"
              },
              "nearest": { "$ref": "defs.schema.json#/$defs/handle" },
              "nearest_taken_for": { "enum": ["carrier", "battleship", "cruiser", "destroyer", "transport", "auxiliary"] },
              "distance_nm": { "type": "integer" }
            }
          }
        }
      }
    }
  }
