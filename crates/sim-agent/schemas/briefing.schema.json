              "fuel_t": { "$ref": "defs.schema.json#/$defs/dec" },
              "task_forces": { "$ref": "defs.schema.json#/$defs/handles" }
            }
          }
        },
        "air_group_short_of_pilots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["air_group", "pilots", "ready"],
