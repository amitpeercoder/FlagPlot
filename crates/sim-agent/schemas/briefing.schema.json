        "fuel_t": { "$ref": "defs.schema.json#/$defs/dec" },
        "spent_yesterday_t": { "$ref": "defs.schema.json#/$defs/dec" },
        "destroyed_yesterday_t": { "$ref": "defs.schema.json#/$defs/dec" },
        "days_of_supply": { "$ref": "defs.schema.json#/$defs/dec_or_null" },
