{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flagplot-agent/briefing",
  "title": "briefing: the situation of one side at the start of a day, in ten parts and the objectives",
  "type": "object",
  "required": [
    "format", "version", "kind", "heading", "objectives", "orders", "contacts", "action", "losses",
    "task_forces", "air_groups", "bases", "arrivals", "warnings"
  ],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "flagplot-agent" },
    "version": { "const": 3 },
    "kind": { "const": "briefing" },
    "heading": { "$ref": "#/$defs/heading" },
    "objectives": { "$ref": "#/$defs/objectives" },
    "orders": { "$ref": "#/$defs/orders" },
    "contacts": { "$ref": "#/$defs/contacts" },
    "action": { "$ref": "#/$defs/action" },
    "losses": { "$ref": "#/$defs/losses" },
    "task_forces": { "type": "array", "items": { "$ref": "defs.schema.json#/$defs/force_line" } },
    "away_at_yard": {
      "description": "The forces away at the yard (decision 0069), each with the day it is back. Left out when none is away.",
      "type": "array",
      "items": { "$ref": "#/$defs/away_force" }
    },
    "air_groups": { "type": "array", "items": { "$ref": "defs.schema.json#/$defs/air_group_line" } },
    "bases": { "type": "array", "items": { "$ref": "#/$defs/base" } },
    "land_units": {
      "description": "The side's land units and what yesterday's events say happened to their men (decision 0066, 21). Left out when the side has no land unit.",
      "$ref": "#/$defs/land_units"
    },
    "arrivals": { "$ref": "#/$defs/arrivals" },
    "warnings": { "$ref": "#/$defs/warnings" }
  },
  "$defs": {
    "objectives": {
      "description": "The side's own mission and objectives (decision 0054), its progress as far as it can know it, and the umpire's result once the game is over. mission is null and objectives empty when the scenario has none; result is null until the game is over (and always null without objectives).",
      "type": "object",
      "required": ["mission", "objectives", "levels", "result"],
      "additionalProperties": false,
      "properties": {
        "mission": { "$ref": "defs.schema.json#/$defs/string_or_null" },
        "objectives": { "type": "array", "items": { "$ref": "#/$defs/objective" } },
        "levels": {
          "description": "From day 1: the margins (a side's points less the enemy's) that make a minor, a major and a decisive victory; the same margins against a side are defeats of the same level, and a margin of less than minor either way is a stalemate. null when the scenario has no objectives.",
          "oneOf": [
            {
              "type": "object",
              "required": ["minor", "major", "decisive"],
              "additionalProperties": false,
              "properties": {
                "minor": { "$ref": "defs.schema.json#/$defs/dec" },
                "major": { "$ref": "defs.schema.json#/$defs/dec" },
                "decisive": { "$ref": "defs.schema.json#/$defs/dec" }
              }
            },
            { "type": "null" }
          ]
        },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/result" },
            { "type": "null" }
          ]
        }
      }
    },
    "objective": {
      "type": "object",
      "required": ["kind", "base", "closed", "ship_points", "points", "known"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["ships_sunk", "ships_crippled", "ships_out_of_action", "aircraft_destroyed", "cargo_landed", "base_open"] },
        "base": { "$ref": "defs.schema.json#/$defs/handle_or_null" },
        "closed": { "type": ["boolean", "null"] },
        "ship_points": {
          "description": "For ships_sunk, ships_crippled and ships_out_of_action: the points for each kind of ship (for ships_out_of_action, for a ship away for the whole horizon). Empty for the others.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "points"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["carrier", "battleship", "cruiser", "destroyer", "transport", "auxiliary"] },
              "points": { "$ref": "defs.schema.json#/$defs/dec" }
            }
          }
        },
        "horizon_days": {
          "description": "For ships_out_of_action only (left out for every other kind): the days of the horizon its shares are of (decision 0088), at least 1.",
          "type": "integer"
        },
        "points": {
          "description": "Points for one aircraft, one ton or the base being as wanted; null for the ship objectives.",
          "$ref": "defs.schema.json#/$defs/dec_or_null"
        },
        "known": {
          "description": "What the side knows of its progress, from its own units and the events it may see. basis is exact, claims (the enemy ships and aircraft the side's own claims say it sank, shot down or destroyed on the ground: they can be wrong, so count can be above the truth; points are for the kind of ship each claim names, or null where none does) or not_observable (count is 0 and says nothing).",
          "type": "object",
          "required": ["basis", "count", "days", "points"],
          "additionalProperties": false,
          "properties": {
            "basis": { "enum": ["exact", "claims", "not_observable"] },
            "count": { "$ref": "defs.schema.json#/$defs/dec" },
            "days": {
              "description": "For base_open at a base of the side's own: the days counted, which count is out of. Null for everything else.",
              "type": ["integer", "null"]
            },
            "points": { "$ref": "defs.schema.json#/$defs/dec_or_null" }
          }
        }
      }
    },
    "result": {
      "description": "The umpire's result for both sides, from the truth, told at the end of the game.",
      "type": "object",
      "required": ["allied", "japanese", "history"],
      "additionalProperties": false,
      "properties": {
        "allied": { "$ref": "#/$defs/side_result" },
        "japanese": { "$ref": "#/$defs/side_result" },
        "history": {
          "description": "What happened in the real battle, not in this game: the scenario's note of how the day went in history, in words and not a computed score. It is not this game's result. null where the scenario gives none.",
          "$ref": "defs.schema.json#/$defs/string_or_null"
        }
      }
    },
    "side_result": {
      "type": "object",
      "required": ["objectives", "total", "margin", "result", "level", "outcome"],
      "additionalProperties": false,
      "properties": {
        "objectives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "base", "closed", "count", "days", "ships", "points"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["ships_sunk", "ships_crippled", "ships_out_of_action", "aircraft_destroyed", "cargo_landed", "base_open"] },
              "base": { "$ref": "defs.schema.json#/$defs/handle_or_null" },
              "closed": { "type": ["boolean", "null"] },
              "count": { "$ref": "defs.schema.json#/$defs/dec" },
              "days": {
                "description": "For base_open: the days counted, which count is out of. Null for the others.",
                "type": ["integer", "null"]
              },
              "ships": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["kind", "ships"],
                  "additionalProperties": false,
                  "properties": {
                    "kind": { "enum": ["carrier", "battleship", "cruiser", "destroyer", "transport", "auxiliary"] },
                    "ships": { "type": "integer" }
                  }
                }
              },
              "points": { "$ref": "defs.schema.json#/$defs/dec" },
              "horizon_days": {
                "description": "For ships_out_of_action only (left out for every other kind): the days of the horizon the shares are of, at least 1.",
                "type": "integer"
              },
              "ships_out": {
                "description": "For ships_out_of_action only (left out when empty): each ship counted, in ship number order, with the days it was away and the points they earned.",
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["ship", "kind", "at_end", "left_with", "days_out", "share", "points"],
                  "additionalProperties": false,
                  "properties": {
                    "ship": { "description": "The side's own handle for a ship of its own (ship:7), with no name; for an enemy ship, which a side has no handle for, enemy_ship:3, her place in this list from 1.", "type": "string" },
                    "kind": { "enum": ["carrier", "battleship", "cruiser", "destroyer", "transport", "auxiliary"] },
                    "at_end": { "description": "Her days of repair still to run at the end of the game.", "type": "integer" },
                    "left_with": { "description": "The days of repair she left for a yard with.", "type": "integer" },
                    "days_out": { "description": "at_end plus left_with.", "type": "integer" },
                    "share": { "description": "min(days_out, horizon) / horizon.", "$ref": "defs.schema.json#/$defs/dec" },
                    "points": { "description": "The kind's points times the share.", "$ref": "defs.schema.json#/$defs/dec" }
                  }
                }
              }
            }
          }
        },
        "total": { "$ref": "defs.schema.json#/$defs/dec" },
        "margin": { "description": "This side's points less the other side's.", "$ref": "defs.schema.json#/$defs/dec" },
        "result": { "enum": ["victory", "defeat", "stalemate"] },
        "level": { "description": "minor, major or decisive; null for a stalemate, which has no level (outcome says it in words).", "enum": ["minor", "major", "decisive", null] },
        "outcome": { "description": "The outcome in words: \"minor victory\", \"major defeat\", \"stalemate\" and so on.", "type": "string" }
      }
    },
    "heading": {
      "type": "object",
      "required": ["side", "day", "last_day", "yesterday", "scenario", "rules_in_play"],
      "additionalProperties": false,
      "properties": {
        "side": { "enum": ["allied", "japanese"] },
        "day": { "type": "integer" },
        "last_day": {
          "description": "The last day of the game: it ends when this day has been resolved. Null if the briefing was made without it.",
          "$ref": "defs.schema.json#/$defs/count_or_null"
        },
        "yesterday": { "$ref": "defs.schema.json#/$defs/count_or_null" },
        "scenario": { "type": "string" },
        "rules_in_play": {
          "description": "Which optional rules are in play; the text leaves out what a rule not in play would make meaningless.",
          "type": "object",
          "required": ["wear", "fatigue", "pilots", "supply"],
          "additionalProperties": false,
          "properties": {
            "wear": { "type": "boolean" },
            "fatigue": { "type": "boolean" },
            "pilots": { "type": "boolean" },
            "supply": { "type": "boolean" }
          }
        }
      }
    },
    "orders": {
      "type": "object",
      "required": ["accepted", "refused"],
      "additionalProperties": false,
      "properties": {
        "accepted": { "type": "integer" },
        "refused": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["order", "target", "reason", "event"],
            "additionalProperties": false,
            "properties": {
              "order": { "type": "integer" },
              "target": { "$ref": "defs.schema.json#/$defs/handle" },
              "reason": { "description": "The engine's own words, with a short hint in brackets of what the order needs where the reason has one.", "type": "string" },
              "event": { "type": "integer" }
            }
          }
        }
      }
    },
    "reported_contact": {
      "type": "object",
      "required": [
        "contact", "place", "ship_count", "taken_for", "event", "was_ship_count",
        "was_taken_for", "was_place"
      ],
      "additionalProperties": false,
      "properties": {
        "contact": { "$ref": "defs.schema.json#/$defs/handle" },
        "place": { "$ref": "defs.schema.json#/$defs/place" },
        "ship_count": { "type": "integer" },
        "taken_for": { "$ref": "#/$defs/ship_kind" },
        "event": { "type": "integer" },
        "was_ship_count": { "$ref": "defs.schema.json#/$defs/count_or_null" },
        "was_taken_for": {
          "type": ["string", "null"],
          "enum": ["carrier", "battleship", "cruiser", "destroyer", "transport", "auxiliary", null]
        },
        "was_place": { "$ref": "defs.schema.json#/$defs/place_or_null" }
      }
    },
    "contacts": {
      "type": "object",
      "required": ["new", "refreshed", "dropped", "not_there", "held"],
      "additionalProperties": false,
      "properties": {
        "new": { "type": "array", "items": { "$ref": "#/$defs/reported_contact" } },
        "refreshed": { "type": "array", "items": { "$ref": "#/$defs/reported_contact" } },
        "dropped": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["contact", "age_pulses", "event"],
            "additionalProperties": false,
            "properties": {
              "contact": { "$ref": "defs.schema.json#/$defs/handle" },
              "age_pulses": { "type": "integer" },
              "event": { "type": "integer" }
            }
          }
        },
        "not_there": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["contact", "place", "event"],
            "additionalProperties": false,
            "properties": {
              "contact": { "$ref": "defs.schema.json#/$defs/handle" },
              "place": { "$ref": "defs.schema.json#/$defs/place" },
              "event": { "type": "integer" }
            }
          }
        },
        "held": { "type": "array", "items": { "$ref": "defs.schema.json#/$defs/contact_line" } }
      }
    },
    "ship_kind": {
      "enum": ["carrier", "battleship", "cruiser", "destroyer", "transport", "auxiliary"]
    },
    "weapon": { "enum": ["guns", "torpedoes", "bombs"] },
    "strike_report": {
      "description": "What a strike reported back: an event that cites its attack or its finding nothing.",
      "type": "object",
      "required": ["result", "contact", "ship_count", "taken_for", "place", "claimed_sunk", "event"],
      "additionalProperties": false,
      "properties": {
        "result": {
          "enum": [
            "contact_new", "contact_refreshed", "contact_dropped", "contact_not_there", "claim"
          ]
        },
        "contact": { "$ref": "defs.schema.json#/$defs/handle_or_null" },
        "ship_count": { "$ref": "defs.schema.json#/$defs/count_or_null" },
        "taken_for": {
          "type": ["string", "null"],
          "enum": ["carrier", "battleship", "cruiser", "destroyer", "transport", "auxiliary", null]
        },
        "place": { "$ref": "defs.schema.json#/$defs/place_or_null" },
        "claimed_sunk": { "$ref": "defs.schema.json#/$defs/count_or_null" },
        "event": { "type": "integer" }
      }
    },
    "weapon_or_null": { "type": ["string", "null"], "enum": ["guns", "torpedoes", "bombs", null] },
    "action": {
      "type": "object",
      "required": [
        "fights", "fired", "air_fire", "guns", "strikes", "raids_on_bases", "attacks_on_ships"
      ],
      "additionalProperties": false,
      "properties": {
        "fights": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["force", "place", "rounds", "ended", "event"],
            "additionalProperties": false,
            "properties": {
              "force": { "$ref": "defs.schema.json#/$defs/handle" },
              "place": { "$ref": "defs.schema.json#/$defs/place" },
              "rounds": { "type": "integer" },
              "ended": {
                "enum": ["slipped_away", "force_sunk", "broke_off", "passed_unseen", "max_rounds", "contact_lost"]
              },
              "event": { "type": "integer" }
            }
          }
        },
        "fired": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["firer", "weapon", "salvos", "shots"],
            "additionalProperties": false,
            "properties": {
              "firer": { "$ref": "defs.schema.json#/$defs/handle" },
              "weapon": { "$ref": "#/$defs/weapon" },
              "salvos": { "type": "integer" },
              "shots": { "$ref": "defs.schema.json#/$defs/dec" }
            }
          }
        },
        "air_fire": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["firing", "firer", "at", "shots", "event"],
            "additionalProperties": false,
            "properties": {
              "firing": { "enum": ["patrol", "escorts"] },
              "firer": { "$ref": "defs.schema.json#/$defs/handle" },
              "at": { "enum": ["patrol", "escorts", "bombers"] },
              "shots": { "$ref": "defs.schema.json#/$defs/dec" },
              "event": { "type": "integer" }
            }
          }
        },
        "guns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["by", "shots", "event"],
            "additionalProperties": false,
            "properties": {
              "by": { "$ref": "defs.schema.json#/$defs/handle" },
              "shots": { "$ref": "defs.schema.json#/$defs/dec" },
              "event": { "type": "integer" }
            }
          }
        },
        "strikes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind", "air_group", "target", "place", "aircraft", "weapon", "distance_nm",
              "event", "reports"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "naval_strike_launched", "base_strike_launched", "strike_found_nothing",
                  "air_attack", "base_attack"
                ]
              },
              "air_group": { "$ref": "defs.schema.json#/$defs/handle" },
              "target": { "$ref": "defs.schema.json#/$defs/handle_or_null" },
              "place": { "$ref": "defs.schema.json#/$defs/place_or_null" },
              "aircraft": { "$ref": "defs.schema.json#/$defs/dec_or_null" },
              "weapon": { "$ref": "#/$defs/weapon_or_null" },
              "distance_nm": { "$ref": "defs.schema.json#/$defs/dec_or_null" },
              "event": { "type": "integer" },
              "reports": { "type": "array", "items": { "$ref": "#/$defs/strike_report" } }
            }
          }
        },
        "raids_on_bases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "base", "aircraft", "hits", "hits_on_aircraft", "hits_on_supply", "event"
            ],
            "additionalProperties": false,
            "properties": {
              "base": { "$ref": "defs.schema.json#/$defs/handle" },
              "aircraft": { "$ref": "defs.schema.json#/$defs/dec" },
              "hits": { "type": "integer" },
              "hits_on_aircraft": { "type": "integer" },
              "hits_on_supply": { "type": "integer" },
              "event": { "type": "integer" }
            }
          }
        },
        "attacks_on_ships": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["by", "against", "weapon", "attacks", "aircraft", "events"],
            "additionalProperties": false,
            "properties": {
              "by": { "enum": ["ship", "aircraft"] },
              "against": { "$ref": "defs.schema.json#/$defs/handle" },
              "weapon": { "$ref": "#/$defs/weapon_or_null" },
              "attacks": { "type": "integer" },
              "aircraft": { "$ref": "defs.schema.json#/$defs/dec_or_null" },
              "events": { "$ref": "defs.schema.json#/$defs/event_numbers" }
            }
          }
        }
      }
    },
    "losses": {
      "type": "object",
      "required": ["ships_sunk", "ships_damaged", "aircraft", "claims"],
      "additionalProperties": false,
      "properties": {
        "ships_sunk": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ship", "task_force", "event"],
            "additionalProperties": false,
            "properties": {
              "ship": { "$ref": "defs.schema.json#/$defs/handle" },
              "task_force": { "$ref": "defs.schema.json#/$defs/handle" },
              "event": { "type": "integer" }
            }
          }
        },
        "ships_damaged": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ship", "hits", "flotation_after", "fire_after", "systems", "events"],
            "additionalProperties": false,
            "properties": {
              "ship": { "$ref": "defs.schema.json#/$defs/handle" },
              "hits": { "type": "integer" },
              "flotation_after": { "$ref": "defs.schema.json#/$defs/dec_or_null" },
              "fire_after": { "$ref": "defs.schema.json#/$defs/dec_or_null" },
              "systems": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["system", "before", "after"],
                  "additionalProperties": false,
                  "properties": {
                    "system": {
                      "enum": [
                        "propulsion", "fire_control", "main_battery", "torpedo_mounts", "flight_deck"
                      ]
                    },
                    "before": { "enum": ["working", "degraded", "out"] },
                    "after": { "enum": ["working", "degraded", "out"] }
                  }
                }
              },
              "events": { "$ref": "defs.schema.json#/$defs/event_numbers" }
            }
          }
        },
        "aircraft": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "air_group", "shot_down", "destroyed_on_ground", "written_off", "lost_with_ship",
              "pilots_lost", "events"
            ],
            "additionalProperties": false,
            "properties": {
              "air_group": { "$ref": "defs.schema.json#/$defs/handle" },
              "shot_down": { "type": "integer" },
              "destroyed_on_ground": { "type": "integer" },
              "written_off": { "type": "integer" },
              "lost_with_ship": { "type": "integer" },
              "no_deck": { "description": "Left out when 0. Aircraft that were in the air when their own deck was lost, found no other carrier with room and no base within reach, and came down in the sea.", "type": "integer" },
              "ditched": { "description": "Left out when 0. Aircraft that ran out of fuel on the way home from a strike or escort sortie beyond their radius, and are lost.", "type": "integer" },
              "pilots_lost": { "type": "integer" },
              "events": { "$ref": "defs.schema.json#/$defs/event_numbers" }
            }
          }
        },
        "aircraft_landed_elsewhere": {
          "description": "Left out when none. Aircraft that were in the air when their own deck was lost (the ship sank or her flight deck went out) and landed at another carrier or a base: from is the group they flew in, to the group that has them now (an existing one, or one formed by the landing), at the ship or base.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "at", "aircraft", "pilots", "formed", "event"],
            "additionalProperties": false,
            "properties": {
              "from": { "$ref": "defs.schema.json#/$defs/handle" },
              "to": { "$ref": "defs.schema.json#/$defs/handle" },
              "at": { "$ref": "defs.schema.json#/$defs/handle" },
              "aircraft": { "type": "integer" },
              "pilots": { "type": "integer" },
              "formed": { "type": "boolean" },
              "event": { "type": "integer" }
            }
          }
        },
        "claims": {
          "description": "Claims yesterday: what the side's own people believe they did in a fight at sea or a raid. They can be wrong. A claim from the air (from_air true) says hits on ships and the kind they were taken for, ships sunk, aircraft shot down and aircraft destroyed on the ground; a claim of a fight at sea says ships sunk only, with the rest 0 and null.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "place", "claimed_sunk", "claimed_hits", "taken_for", "claimed_shot_down",
              "claimed_on_ground", "from_air", "event"
            ],
            "additionalProperties": false,
            "properties": {
              "place": { "$ref": "defs.schema.json#/$defs/place" },
              "claimed_sunk": { "type": "integer" },
              "claimed_hits": { "type": "integer" },
              "taken_for": {
                "type": ["string", "null"],
                "enum": ["carrier", "battleship", "cruiser", "destroyer", "transport", "auxiliary", null]
              },
              "claimed_shot_down": { "type": "integer" },
              "claimed_on_ground": { "type": "integer" },
              "from_air": { "type": "boolean" },
              "event": {
                "description": "The event that told the side; explain on it shows the side's own firing it rests on.",
                "type": "integer"
              }
            }
          }
        }
      }
    },
