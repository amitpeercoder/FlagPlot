              "task_force": { "$ref": "defs.schema.json#/$defs/handle" },
              "land_unit": { "$ref": "defs.schema.json#/$defs/handle" },
              "base": { "description": "The base loaded from; null off a bare shore.", "$ref": "defs.schema.json#/$defs/handle_or_null" },
              "cargo": { "description": "supply or fuel; null for a load of men only.", "enum": ["supply", "fuel", null] },
              "event": { "type": "integer" }
            }
          }
        },
        "fed_last_night": {
          "type": "array",
          "items": {
