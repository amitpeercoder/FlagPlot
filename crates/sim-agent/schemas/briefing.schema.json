        "task_force": { "$ref": "defs.schema.json#/$defs/handle" },
        "points": { "$ref": "defs.schema.json#/$defs/dec" },
        "fire_damage": { "$ref": "defs.schema.json#/$defs/dec" },
        "flotation_damage": { "$ref": "defs.schema.json#/$defs/dec" },
        "restored": { "type": "array", "items": { "enum": ["propulsion", "fire_control", "main_battery", "torpedo_mounts", "flight_deck"] } },
        "systems_degraded": { "type": "array", "items": { "enum": ["propulsion", "fire_control", "main_battery", "torpedo_mounts", "flight_deck"] } },
        "systems_out": { "type": "array", "items": { "enum": ["propulsion", "fire_control", "main_battery", "torpedo_mounts", "flight_deck"] } },
