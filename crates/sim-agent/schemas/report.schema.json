{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flagplot-agent/report",
  "title": "report: what is open and what closed in your command of the staff, and the interrupts",
  "description": "Worked from your events and stored nowhere. A matter is a plan, a run where there is one and a kind of notice. It is open if the staff handed it in on the last day resolved, else closed, on the first day after its last day. Each day of its history gives the why number of that day's reason.",
  "type": "object",
  "required": [
    "format",
    "version",
    "kind",
    "day",
    "matters",
    "open_matters",
    "closed_matters",
    "interrupts",
    "fired_last_day",
    "summary",
    "holds",
    "neutralisations",
    "denials"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "flagplot-agent"
    },
    "version": {
      "const": 15
    },
    "kind": {
      "const": "report"
    },
    "day": {
      "type": "integer",
      "description": "The number of days resolved."
    },
    "matters": {
      "type": "array",
      "description": "Open matters first, then closed; each by first day, then plan, run and kind.",
      "items": {
        "type": "object",
        "required": [
          "plan",
          "intent",
          "run",
          "kind",
          "words",
          "open",
          "opened",
          "closed",
          "history"
        ],
        "additionalProperties": false,
        "properties": {
          "plan": {
            "type": "integer"
          },
          "intent": {
            "type": [
              "integer",
              "null"
            ]
          },
          "run": {
            "type": [
              "integer",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "cannot_meet",
              "waits_for_leave_to_prepare",
              "waits_for_leave_to_launch",
              "run_ended"
            ]
          },
          "words": {
            "type": "string"
          },
          "open": {
            "type": "boolean"
          },
          "opened": {
            "type": "integer"
          },
          "closed": {
            "type": [
              "integer",
              "null"
            ],
            "description": "The first day on which it was not handed in; null while open."
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "day",
                "why"
              ],
              "additionalProperties": false,
              "properties": {
                "day": {
                  "type": "integer"
                },
                "why": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "The number why takes for the reason that day's notice rests on."
                }
              }
            }
          }
        }
      }
    },
    "open_matters": {
      "type": "integer"
    },
    "closed_matters": {
      "type": "integer"
    },
    "interrupts": {
      "$ref": "command_defs.schema.json#/$defs/interrupts"
    },
    "fired_last_day": {
      "type": "array",
      "items": {
        "$ref": "command_defs.schema.json#/$defs/firing"
      }
    },
    "summary": {
      "type": "string"
    },
    "holds": {
      "type": "array",
      "description": "The hold intents in force with the measure of each (decision 0117, 14).",
      "items": {
        "type": "object",
        "description": "The measure of a hold intent (decision 0117, 14): the days it has been in force and the days of them the base was the side's at the end of the day with its airfield open, the air raids on the base in those days and how many a patrol of the side's fought, the base's days of supply today (null where no figure), and the words.",
        "required": [
          "days_in_force",
          "days_met",
          "raids",
          "raids_fought",
          "days_of_supply",
          "text",
          "intent",
          "base"
        ],
        "additionalProperties": false,
        "properties": {
          "days_in_force": {
            "type": "integer"
          },
          "days_met": {
            "type": "integer"
          },
          "raids": {
            "type": "integer"
          },
          "raids_fought": {
            "type": "integer"
          },
          "days_of_supply": {
            "oneOf": [
              {
                "$ref": "defs.schema.json#/$defs/dec"
              },
              {
                "type": "null"
              }
            ]
          },
          "text": {
            "type": "string"
          },
          "intent": {
            "type": "integer"
          },
          "base": {
            "$ref": "defs.schema.json#/$defs/handle"
          }
        }
      }
    },
    "neutralisations": {
      "type": "array",
      "description": "The neutralise intents in force with the measure of each (decision 0120, 8).",
      "items": {
        "type": "object",
        "description": "The measure of a neutralise intent: the days it has been in force, the raids flown on the target in them, the aircraft claimed destroyed on the ground there (a claim of the side's people), the air raids on the side's own bases and the days of them on which none was raided, and the words.",
        "required": [
          "days_in_force",
          "days_met",
          "raids_flown",
          "claimed_on_ground",
          "raids_on_own_bases",
          "text",
          "intent",
          "target"
        ],
        "additionalProperties": false,
        "properties": {
          "days_in_force": {
            "type": "integer"
          },
          "days_met": {
            "type": "integer"
          },
          "raids_flown": {
            "type": "integer"
          },
          "claimed_on_ground": {
            "type": "integer"
          },
          "raids_on_own_bases": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "intent": {
            "type": "integer"
          },
          "target": {
            "$ref": "defs.schema.json#/$defs/handle"
          }
        }
      }
    },
    "denials": {
      "type": "array",
      "description": "The deny intents in force with the measure of each (decision 0123, 4).",
      "items": {
        "type": "object",
        "description": "The measure of a deny intent, with the intent's number and its waters.",
        "required": [
          "days_in_force",
          "contacts_held",
          "strikes_launched",
          "claimed_sunk",
          "claimed_hits",
          "days_met",
          "text",
          "intent",
          "hex",
          "distance"
        ],
        "additionalProperties": false,
        "properties": {
          "days_in_force": {
            "type": "integer"
          },
          "contacts_held": {
            "type": "integer"
          },
          "strikes_launched": {
            "type": "integer"
          },
          "claimed_sunk": {
            "type": "integer"
          },
          "claimed_hits": {
            "type": "integer"
          },
          "days_met": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "intent": {
            "type": "integer"
          },
          "hex": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "distance": {
            "type": "integer"
          }
        }
      }
    }
  }
}
