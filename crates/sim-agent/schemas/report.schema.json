{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flagplot-agent/report",
  "title": "report: what is open and what closed in your command of the staff, and the interrupts",
  "description": "Worked from your events and stored nowhere. A matter is a plan, a run where there is one and a kind of notice. It is open if the staff handed it in on the last day resolved, else closed, on the first day after its last day. Each day of its history gives the why number of that day's reason.",
  "type": "object",
  "required": [
    "format",
    "version",
    "kind",
    "day",
    "matters",
    "open_matters",
    "closed_matters",
    "interrupts",
    "fired_last_day",
    "summary",
    "holds",
    "islands",
    "neutralisations",
    "denials",
    "refusals"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "flagplot-agent"
    },
    "version": {
      "const": 56
    },
    "kind": {
      "const": "report"
    },
    "day": {
      "type": "integer",
      "description": "The number of days resolved."
    },
    "matters": {
      "type": "array",
      "description": "Open matters first, then closed; each by first day, then plan, run and kind.",
      "items": {
        "type": "object",
        "required": [
          "plan",
          "intent",
          "run",
          "kind",
          "words",
          "open",
          "opened",
          "closed",
          "history"
        ],
        "additionalProperties": false,
        "properties": {
          "plan": {
            "type": "integer"
          },
          "intent": {
            "type": [
              "integer",
              "null"
            ]
          },
          "run": {
            "type": [
              "integer",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "cannot_meet",
              "waits_for_leave_to_prepare",
              "waits_for_leave_to_launch",
              "run_ended",
              "ready",
              "late",
              "met",
              "cannot_bring_enough",
              "lift_turned_back",
              "asks_leave_to_pursue",
              "pursues",
              "pursuit_ended",
              "follows",
              "contact_lost",
              "force_not_found"
            ]
          },
          "task_force": {
            "type": "integer",
            "description": "Decision 0214: for the three notices of a pursuit, your task force's number; each force's pursuit is a matter of its own."
          },
          "pursuit_intent": {
            "type": "integer",
            "description": "Decision 0214: for a pursuit notice, the intent the force would leave or has left."
          },
          "contact": {
            "type": "integer",
            "description": "Decision 0214: for a pursuit notice that names a find, the contact's number."
          },
          "order": {
            "type": "integer",
            "description": "Decision 0220: for a notice of following, the number of the order (the intent) it is about; each order's following is a matter of its own."
          },
          "words": {
            "type": "string"
          },
          "open": {
            "type": "boolean"
          },
          "opened": {
            "type": "integer"
          },
          "closed": {
            "type": [
              "integer",
              "null"
            ],
            "description": "The first day on which it was not handed in; null while open."
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "day",
                "why"
              ],
              "additionalProperties": false,
              "properties": {
                "day": {
                  "type": "integer"
                },
                "why": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "The number why takes for the reason that day's notice rests on."
                }
              }
            }
          }
        }
      }
    },
    "open_matters": {
      "type": "integer"
    },
    "closed_matters": {
      "type": "integer"
    },
    "interrupts": {
      "$ref": "command_defs.schema.json#/$defs/interrupts"
    },
    "fired_last_day": {
      "type": "array",
      "items": {
        "$ref": "command_defs.schema.json#/$defs/firing"
      }
    },
    "summary": {
      "type": "string"
    },
    "holds": {
      "type": "array",
      "description": "The hold intents in force with the measure of each (decision 0117, 14).",
      "items": {
        "type": "object",
        "description": "The measure of a hold intent (decision 0117, 14): the days it has been in force and the days of them the base was the side's at the end of the day with its airfield open, the air raids on the base in those days and how many a patrol of the side's fought, the base's days of supply today (null where no figure), and the words.",
        "required": [
          "days_in_force",
          "days_met",
          "raids",
          "raids_fought",
          "days_of_supply",
          "text",
          "intent",
          "base"
        ],
        "additionalProperties": false,
        "properties": {
          "days_in_force": {
            "type": "integer"
          },
          "days_met": {
            "type": "integer"
          },
          "raids": {
            "type": "integer"
          },
          "raids_fought": {
            "type": "integer"
          },
          "days_of_supply": {
            "oneOf": [
              {
                "$ref": "defs.schema.json#/$defs/dec"
              },
              {
                "type": "null"
              }
            ]
          },
          "text": {
            "type": "string"
          },
          "intent": {
            "type": "integer"
          },
          "base": {
            "$ref": "defs.schema.json#/$defs/handle"
          }
        }
      }
    },
    "islands": {
      "type": "array",
      "description": "The control_island intents in force with the measure of each (decision 0151, 11).",
      "items": {
        "type": "object",
        "description": "The measure of a control_island intent: the days it has been in force, the days of them on which every named place was the side's at the end of the day with its supply above its reserve and at least its floor of days of supply, each place as the side stands in it today, and the words.",
        "required": [
          "days_in_force",
          "days_controlled",
          "places",
          "text",
          "intent",
          "island"
        ],
        "additionalProperties": false,
        "properties": {
          "days_in_force": {
            "type": "integer"
          },
          "days_controlled": {
            "type": "integer"
          },
          "places": {
            "type": "array",
            "description": "The island's named places in its order: hex, base (null for a bare coast hex), ours and days_of_supply (null where no figure).",
            "items": {
              "type": "object",
              "required": ["hex", "base", "ours", "days_of_supply"],
              "additionalProperties": false,
              "properties": {
                "hex": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
                "base": { "type": ["integer", "null"] },
                "ours": { "type": "boolean" },
                "days_of_supply": {
                  "oneOf": [
                    { "$ref": "defs.schema.json#/$defs/dec" },
                    { "type": "null" }
                  ]
                }
              }
            }
          },
          "text": {
            "type": "string"
          },
          "intent": {
            "type": "integer"
          },
          "island": {
            "type": "integer"
          }
        }
      }
    },
    "neutralisations": {
      "type": "array",
      "description": "The neutralise intents in force with the measure of each (decision 0120, 8).",
      "items": {
        "type": "object",
        "description": "The measure of a neutralise intent: the days it has been in force, the raids flown on the target in them, the aircraft claimed destroyed on the ground there (a claim of the side's people), the air raids on the side's own bases and the days of them on which none was raided, and the words.",
        "required": [
          "days_in_force",
          "days_met",
          "raids_flown",
          "claimed_on_ground",
          "raids_on_own_bases",
          "text",
          "intent",
          "target"
        ],
        "additionalProperties": false,
        "properties": {
          "days_in_force": {
            "type": "integer"
          },
          "days_met": {
            "type": "integer"
          },
          "raids_flown": {
            "type": "integer"
          },
          "claimed_on_ground": {
            "type": "integer"
          },
          "raids_on_own_bases": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "intent": {
            "type": "integer"
          },
          "target": {
            "$ref": "defs.schema.json#/$defs/handle"
          }
        }
      }
    },
    "refusals": {
      "type": "object",
      "description": "Refusals over the whole game, from your own events (decision 0138, 4): staff orders refused because a force was not as the area command held it (decision 0136, 14), staff orders refused for any other cause, and commands refused.",
      "required": ["staff_orders_not_as_held", "staff_orders_other", "commands"],
      "additionalProperties": false,
      "properties": {
        "staff_orders_not_as_held": { "type": "integer" },
        "staff_orders_other": { "type": "integer" },
        "commands": { "type": "integer" }
      }
    },
    "denials": {
      "type": "array",
      "description": "The deny intents in force with the measure of each (decision 0123, 4).",
      "items": {
        "type": "object",
        "description": "The measure of a deny intent, with the intent's number and its waters.",
        "required": [
          "days_in_force",
          "contacts_held",
          "strikes_launched",
          "claimed_sunk",
          "claimed_hits",
          "days_met",
          "text",
          "intent",
          "hex",
          "distance"
        ],
        "additionalProperties": false,
        "properties": {
          "days_in_force": {
            "type": "integer"
          },
          "contacts_held": {
            "type": "integer"
          },
          "strikes_launched": {
            "type": "integer"
          },
          "claimed_sunk": {
            "type": "integer"
          },
          "claimed_hits": {
            "type": "integer"
          },
          "days_met": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "intent": {
            "type": "integer"
          },
          "hex": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "distance": {
            "type": "integer"
          }
        }
      }
    }
  }
}
