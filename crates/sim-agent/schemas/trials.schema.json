{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flagplot-agent/trials",
  "title": "trials: the estimates the seat was shown",
  "description": "Decisions 0178 and 0181: the estimates of a trial this seat has been shown, each with its kind (trial or window), what was asked, the evening it was asked and whether it still stands (current, asked on an earlier evening, or asked before the queue changed). Given with an estimate's number, trials returns that stored answer itself (kind trial or window). Changes nothing; kept with the session.",
  "type": "object",
  "required": [
    "format",
    "version",
    "kind",
    "estimates",
    "text"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "flagplot-agent"
    },
    "version": {
      "const": 44
    },
    "kind": {
      "const": "trials"
    },
    "estimates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "estimate",
          "kind",
          "asked_on",
          "inside_day",
          "asked",
          "standing"
        ],
        "additionalProperties": false,
        "properties": {
          "estimate": {
            "type": "integer"
          },
          "kind": {
            "enum": [
              "trial",
              "window"
            ]
          },
          "asked_on": {
            "type": "object",
            "required": [
              "days_resolved",
              "for_day"
            ],
            "additionalProperties": false,
            "properties": {
              "days_resolved": {
                "type": "integer"
              },
              "for_day": {
                "type": "integer"
              }
            }
          },
          "inside_day": {
            "$ref": "trial.schema.json#/properties/asked/properties/inside_day"
          },
          "asked": {
            "$ref": "trial.schema.json#/properties/asked"
          },
          "standing": {
            "type": "string",
            "enum": [
              "current",
              "earlier_evening",
              "queue_changed"
            ]
          }
        }
      }
    },
    "text": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
