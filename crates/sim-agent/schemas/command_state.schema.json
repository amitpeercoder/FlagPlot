{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flagplot-agent/command_state",
  "title": "command_state: the side's command state as it will stand when the coming day begins",
  "description": "Intents with their limits and the staff's projection, the leaves, the bases' reserves, plans, commitments, the interrupts set, the commands queued for the coming day and the staff's decisions of yesterday with their numbers for why. The staff does nothing for a side until an intent is set (a supply intent needs a forces limit; a hold or cover intent may use the groups at its base).",
  "type": "object",
  "required": [
    "format",
    "version",
    "kind",
    "for_day",
    "as_at",
    "notes",
    "leaves",
    "intents",
    "reserves",
    "plans",
    "commitments",
    "holds",
    "interrupts",
    "queued",
    "staff_decisions_yesterday"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "flagplot-agent"
    },
    "version": {
      "const": 11
    },
    "kind": {
      "const": "command_state"
    },
    "for_day": {
      "type": "integer"
    },
    "as_at": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "leaves": {
      "type": "object",
      "required": [
        "prepare",
        "launch",
        "meaning"
      ],
      "additionalProperties": false,
      "properties": {
        "prepare": {
          "type": "boolean"
        },
        "launch": {
          "type": "boolean"
        },
        "meaning": {
          "type": "string"
        }
      }
    },
    "intents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "number",
          "in_force",
          "kind",
          "base",
          "target",
          "hex",
          "distance",
          "task_force",
          "floor_days",
          "interval_days",
          "interval",
          "set_day",
          "withdrawn_day",
          "plan",
          "limits",
          "projection",
          "served",
          "displaced_by",
          "parent",
          "maker",
          "addressee",
          "children",
          "depth",
          "limits_read_up"
        ],
        "additionalProperties": false,
        "properties": {
          "number": {
            "type": "integer"
          },
          "in_force": {
            "type": "boolean"
          },
          "kind": {
            "enum": [
              "keep_supplied",
              "cover",
              "hold",
              "neutralise",
              "raid",
              "deny",
              "strike_ships",
              "search_waters",
              "stand_at",
              "operate_carriers"
            ]
          },
          "base": {
            "oneOf": [
              {
                "$ref": "defs.schema.json#/$defs/handle"
              },
              {
                "type": "null"
              }
            ],
            "description": "The side's own base the intent names; null for neutralise, deny, stand_at and operate_carriers."
          },
          "target": {
            "oneOf": [
              {
                "$ref": "defs.schema.json#/$defs/handle"
              },
              {
                "type": "null"
              }
            ],
            "description": "The enemy base a neutralise or a raid is aimed at (decision 0120); null for the other kinds."
          },
          "hex": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "The centre of the waters of a deny intent as [q, r] (decision 0123), or the station of a stand_at or operate_carriers intent; null for the other kinds."
          },
          "distance": {
            "type": [
              "integer",
              "null"
            ],
            "description": "The distance in hexes of the waters of a deny intent (decision 0123); null for the other kinds."
          },
          "task_force": {
            "type": [
              "integer",
              "null"
            ],
            "description": "The side's number of the task force a stand_at or operate_carriers intent names (decisions 0124 and 0125); null for the other kinds. hex is then its station."
          },
          "floor_days": {
            "type": [
              "integer",
              "null"
            ]
          },
          "interval_days": {
            "type": [
              "integer",
              "null"
            ]
          },
          "interval": {
            "type": [
              "string",
              "null"
            ],
            "description": "For keep_supplied: the days between shipments, or \"not set: the staff uses 15\"; null for the other kinds."
          },
          "set_day": {
            "type": "integer"
          },
          "withdrawn_day": {
            "type": [
              "integer",
              "null"
            ]
          },
          "plan": {
            "type": "integer"
          },
          "limits": {
            "$ref": "command_defs.schema.json#/$defs/limits"
          },
          "projection": {
            "oneOf": [
              {
                "$ref": "command_defs.schema.json#/$defs/projection_summary"
              },
              {
                "type": "null"
              }
            ]
          },
          "served": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Its place in the order the staff serves the intents in force, 1 first; null where withdrawn."
          },
          "displaced_by": {
            "type": "array",
            "items": {
              "$ref": "command_defs.schema.json#/$defs/displacement"
            },
            "description": "The commitments to other plans that keep the intent from a run today or cut its load, from the proposal's shortfall; empty where none."
          },
          "parent": {
            "type": [
              "integer",
              "null"
            ],
            "description": "The intent it stands under; null for a root."
          },
          "maker": {
            "enum": [
              "commander",
              "staff"
            ]
          },
          "addressee": {
            "type": "string",
            "description": "The level it is given to: \"the area\", a base, or a task force (decisions 0124 and 0125)."
          },
          "children": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "The intents in force directly under it."
          },
          "depth": {
            "type": "integer",
            "description": "How many intents are above it; 0 for a root."
          },
          "limits_read_up": {
            "$ref": "command_defs.schema.json#/$defs/limits_read_up"
          },
          "measure": {
            "oneOf": [
              {
                "$ref": "command_defs.schema.json#/$defs/hold_measure"
              },
              {
                "$ref": "command_defs.schema.json#/$defs/neutralise_measure"
              },
              {
                "$ref": "command_defs.schema.json#/$defs/deny_measure"
              }
            ],
            "description": "A hold intent (its hold measure), a neutralise intent (its neutralise measure) or a deny intent (its deny measure) only."
          }
        }
      },
      "description": "Every intent of the side, each root by number with the intents under it listed after it (a sub-intent under its parent); a withdrawn one stays in the list."
    },
    "reserves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "base",
          "supply_t",
          "fuel_t",
          "supply_reserve_t",
          "fuel_reserve_t"
        ],
        "additionalProperties": false,
        "properties": {
          "base": {
            "$ref": "defs.schema.json#/$defs/handle"
          },
          "supply_t": {
            "$ref": "defs.schema.json#/$defs/dec"
          },
          "fuel_t": {
            "$ref": "defs.schema.json#/$defs/dec"
          },
          "supply_reserve_t": {
            "$ref": "defs.schema.json#/$defs/dec"
          },
          "fuel_reserve_t": {
            "$ref": "defs.schema.json#/$defs/dec"
          }
        }
      }
    },
    "plans": {
      "type": "array",
      "items": {
        "$ref": "command_defs.schema.json#/$defs/plan"
      }
    },
    "commitments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ship",
          "plan",
          "run",
          "from_day",
          "to_day"
        ],
        "additionalProperties": false,
        "properties": {
          "ship": {
            "type": "integer"
          },
          "plan": {
            "type": "integer"
          },
          "run": {
            "type": [
              "integer",
              "null"
            ]
          },
          "from_day": {
            "type": "integer"
          },
          "to_day": {
            "type": "integer"
          }
        }
      }
    },
    "holds": {
      "type": "array",
      "description": "What you hold from the staff: each hold with its target in your numbers, the day it was made, what made it (a hold command of yours, or an order of yours to a unit in an intent's forces limit) and that order's number, and the words.",
      "items": {
        "type": "object",
        "required": [
          "target",
          "day",
          "made_by",
          "order",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "target": {
            "$ref": "command_defs.schema.json#/$defs/hold_target"
          },
          "day": {
            "type": "integer"
          },
          "made_by": {
            "enum": [
              "command",
              "order"
            ]
          },
          "order": {
            "type": [
              "integer",
              "null"
            ],
            "description": "For a hold made by an order: the order's number as the side is shown it; null for a hold command."
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "queued": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "command",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer"
          },
          "command": {
            "$ref": "command_defs.schema.json#/$defs/command_body"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "staff_decisions_yesterday": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "number",
          "day",
          "for",
          "summary",
          "carried_out"
        ],
        "additionalProperties": false,
        "properties": {
          "number": {
            "type": "integer"
          },
          "day": {
            "type": "integer"
          },
          "for": {
            "enum": [
              "order",
              "command",
              "no_order"
            ]
          },
          "summary": {
            "type": "string"
          },
          "carried_out": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "interrupts": {
      "$ref": "command_defs.schema.json#/$defs/interrupts"
    }
  }
}
